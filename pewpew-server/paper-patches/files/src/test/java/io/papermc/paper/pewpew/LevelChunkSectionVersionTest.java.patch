+package io.papermc.paper.pewpew;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import com.mojang.serialization.Lifecycle;
+import net.minecraft.core.MappedRegistry;
+import net.minecraft.core.RegistrationInfo;
+import net.minecraft.core.registries.Registries;
+import net.minecraft.world.level.biome.Biome;
+import net.minecraft.world.level.biome.BiomeGenerationSettings;
+import net.minecraft.world.level.biome.BiomeSpecialEffects;
+import net.minecraft.world.level.biome.Biomes;
+import net.minecraft.world.level.biome.MobSpawnSettings;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.chunk.LevelChunkSection;
+import org.junit.jupiter.api.Test;
+
+public class LevelChunkSectionVersionTest {
+    @Test
+    public void changeVersionIncrementsOnMutation() {
+        LevelChunkSection section = new LevelChunkSection(buildTestBiomeRegistry());
+        long initial = section.getChangeVersion();
+
+        section.setBlockState(0, 0, 0, Blocks.DIRT.defaultBlockState());
+        long afterFirst = section.getChangeVersion();
+        assertTrue(afterFirst > initial, "expected change version to increment on first mutation");
+
+        section.setBlockState(0, 0, 0, Blocks.DIRT.defaultBlockState());
+        long afterSame = section.getChangeVersion();
+        assertEquals(afterFirst, afterSame, "expected change version to stay when setting same state");
+
+        section.setBlockState(0, 0, 0, Blocks.STONE.defaultBlockState());
+        long afterSecond = section.getChangeVersion();
+        assertTrue(afterSecond > afterSame, "expected change version to increment on state change");
+    }
+
+    private static MappedRegistry<Biome> buildTestBiomeRegistry() {
+        MappedRegistry<Biome> registry = new MappedRegistry<>(Registries.BIOME, Lifecycle.stable());
+        BiomeSpecialEffects effects = new BiomeSpecialEffects.Builder()
+            .fogColor(0)
+            .waterColor(0)
+            .waterFogColor(0)
+            .skyColor(0)
+            .build();
+        Biome biome = new Biome.BiomeBuilder()
+            .temperature(0.8F)
+            .downfall(0.4F)
+            .specialEffects(effects)
+            .mobSpawnSettings(MobSpawnSettings.EMPTY)
+            .generationSettings(BiomeGenerationSettings.EMPTY)
+            .build();
+        registry.register(Biomes.PLAINS, biome, RegistrationInfo.BUILT_IN);
+        return registry;
+    }
+}
