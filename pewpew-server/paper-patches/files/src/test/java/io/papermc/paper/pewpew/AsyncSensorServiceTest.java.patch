+package io.papermc.paper.pewpew;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.junit.jupiter.api.Assertions.fail;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.doAnswer;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import java.util.List;
+import java.util.UUID;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicReference;
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.entity.ai.Brain;
+import net.minecraft.world.entity.ai.memory.MemoryModuleType;
+import net.minecraft.world.entity.player.Player;
+import org.bukkit.craftbukkit.CraftWorld;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.AfterAll;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.mockito.Answers;
+
+@Normal
+class AsyncSensorServiceTest {
+    @BeforeEach
+    void enableAsyncSensors() {
+        System.setProperty("pewpew.asyncSensors", "true");
+        System.setProperty("pewpew.async.testing", "true");
+    }
+
+    @AfterEach
+    void clearProperties() {
+        System.clearProperty("pewpew.asyncSensors");
+        System.clearProperty("pewpew.async.testing");
+    }
+
+    @AfterAll
+    static void shutdownAsyncPool() {
+        PewpewAsyncPool.shutdownForTesting();
+    }
+
+    @Test
+    void nearestLivingEntitiesCommitSortsAndFilters() throws Exception {
+        String worldName = "test-world-living";
+        ServerLevel level = mockLevel(worldName);
+
+        CountDownLatch latch = new CountDownLatch(2);
+        AtomicReference<List<LivingEntity>> resolved = new AtomicReference<>();
+        Brain brain = mock(Brain.class, invocation -> {
+            if ("setMemory".equals(invocation.getMethod().getName())) {
+                MemoryModuleType<?> type = invocation.getArgument(0);
+                if (type == MemoryModuleType.NEAREST_LIVING_ENTITIES) {
+                    @SuppressWarnings("unchecked")
+                    List<LivingEntity> value = (List<LivingEntity>) invocation.getArgument(1);
+                    resolved.set(value);
+                }
+                latch.countDown();
+                return null;
+            }
+            return Answers.RETURNS_DEFAULTS.answer(invocation);
+        });
+        LivingEntity owner = mockLivingEntity(brain, UUID.randomUUID(), 0.0, 0.0, 0.0);
+        when(level.getEntity(owner.getUUID())).thenReturn(owner);
+
+        LivingEntity near = mockLivingEntity(null, UUID.randomUUID(), 3.0, 0.0, 0.0);
+        LivingEntity far = mockLivingEntity(null, UUID.randomUUID(), 7.0, 0.0, 0.0);
+        LivingEntity outOfRange = mockLivingEntity(null, UUID.randomUUID(), 11.0, 0.0, 0.0);
+        when(level.getEntity(near.getUUID())).thenReturn(near);
+        when(level.getEntity(far.getUUID())).thenReturn(far);
+        when(level.getEntity(outOfRange.getUUID())).thenReturn(outOfRange);
+
+        assertTrue(
+            AsyncSensorService.scheduleNearestLivingEntities(
+                level,
+                owner,
+                List.of(far, outOfRange, near),
+                10.0
+            )
+        );
+
+        awaitCommits(worldName, latch);
+
+        assertEquals(List.of(near, far), resolved.get());
+        WorldTickCoordinator.get().invalidateWorld(worldName);
+    }
+
+    @Test
+    void nearestPlayersCommitClearsVisibleMemories() throws Exception {
+        String worldName = "test-world-players";
+        ServerLevel level = mockLevel(worldName);
+
+        CountDownLatch latch = new CountDownLatch(4);
+        AtomicReference<List<Player>> nearestPlayers = new AtomicReference<>();
+        AtomicReference<Player> visiblePlayer = new AtomicReference<>();
+        AtomicReference<List<Player>> attackablePlayers = new AtomicReference<>();
+        AtomicReference<Player> attackablePlayer = new AtomicReference<>();
+        Brain brain = mock(Brain.class, invocation -> {
+            if ("setMemory".equals(invocation.getMethod().getName())) {
+                MemoryModuleType<?> type = invocation.getArgument(0);
+                if (type == MemoryModuleType.NEAREST_PLAYERS) {
+                    @SuppressWarnings("unchecked")
+                    List<Player> value = (List<Player>) invocation.getArgument(1);
+                    nearestPlayers.set(value);
+                } else if (type == MemoryModuleType.NEAREST_VISIBLE_PLAYER) {
+                    visiblePlayer.set(invocation.getArgument(1));
+                } else if (type == MemoryModuleType.NEAREST_VISIBLE_ATTACKABLE_PLAYERS) {
+                    @SuppressWarnings("unchecked")
+                    List<Player> value = (List<Player>) invocation.getArgument(1);
+                    attackablePlayers.set(value);
+                } else if (type == MemoryModuleType.NEAREST_VISIBLE_ATTACKABLE_PLAYER) {
+                    attackablePlayer.set(invocation.getArgument(1));
+                }
+                latch.countDown();
+                return null;
+            }
+            return Answers.RETURNS_DEFAULTS.answer(invocation);
+        });
+        LivingEntity owner = mockLivingEntity(brain, UUID.randomUUID(), 0.0, 0.0, 0.0);
+        when(level.getEntity(owner.getUUID())).thenReturn(owner);
+
+        Player near = mockPlayer(UUID.randomUUID(), 4.0, 0.0, 0.0);
+        Player far = mockPlayer(UUID.randomUUID(), 6.0, 0.0, 0.0);
+        when(level.getPlayerByUUID(near.getUUID())).thenReturn(near);
+        when(level.getPlayerByUUID(far.getUUID())).thenReturn(far);
+
+        assertTrue(
+            AsyncSensorService.scheduleNearestPlayers(
+                level,
+                owner,
+                List.of(far, near),
+                8.0
+            )
+        );
+
+        awaitCommits(worldName, latch);
+
+        assertEquals(List.of(near, far), nearestPlayers.get());
+        assertNull(visiblePlayer.get());
+        assertEquals(List.of(), attackablePlayers.get());
+        assertNull(attackablePlayer.get());
+        WorldTickCoordinator.get().invalidateWorld(worldName);
+    }
+
+    private static ServerLevel mockLevel(String worldName) {
+        ServerLevel level = mock(ServerLevel.class);
+        CraftWorld world = mock(CraftWorld.class);
+        when(world.getName()).thenReturn(worldName);
+        when(level.getWorld()).thenReturn(world);
+        return level;
+    }
+
+    private static LivingEntity mockLivingEntity(Brain brain, UUID id, double x, double y, double z) {
+        LivingEntity entity = mock(LivingEntity.class);
+        when(entity.getUUID()).thenReturn(id);
+        when(entity.isAlive()).thenReturn(true);
+        when(entity.blockPosition()).thenReturn(BlockPos.ZERO);
+        when(entity.getX()).thenReturn(x);
+        when(entity.getY()).thenReturn(y);
+        when(entity.getZ()).thenReturn(z);
+        if (brain != null) {
+            when(entity.getBrain()).thenReturn(brain);
+        }
+        doAnswer(invocation -> {
+            Entity target = invocation.getArgument(0);
+            double dx = target.getX() - x;
+            double dy = target.getY() - y;
+            double dz = target.getZ() - z;
+            return dx * dx + dy * dy + dz * dz;
+        }).when(entity).distanceToSqr(any(Entity.class));
+        return entity;
+    }
+
+    private static Player mockPlayer(UUID id, double x, double y, double z) {
+        Player player = mock(Player.class);
+        when(player.getUUID()).thenReturn(id);
+        when(player.isAlive()).thenReturn(true);
+        when(player.getX()).thenReturn(x);
+        when(player.getY()).thenReturn(y);
+        when(player.getZ()).thenReturn(z);
+        return player;
+    }
+
+    private static void awaitCommits(String worldName, CountDownLatch latch) throws InterruptedException {
+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);
+        while (System.nanoTime() < deadline) {
+            WorldTickCoordinator.get().drainCommits(List.of(worldName));
+            if (latch.await(10, TimeUnit.MILLISECONDS)) {
+                return;
+            }
+        }
+        fail("Timed out waiting for async sensor commit");
+    }
+}
