+package io.papermc.paper.pewpew;
+
+import java.util.Objects;
+import java.util.concurrent.ConcurrentHashMap;
+import net.minecraft.world.level.pathfinder.SnapshotPathNavigationRegion;
+
+public final class AsyncSnapshotCache {
+    private static final AsyncSnapshotCache INSTANCE = new AsyncSnapshotCache();
+
+    private final ConcurrentHashMap<String, SnapshotPathNavigationRegion.SectionCache> sectionCaches =
+        new ConcurrentHashMap<>();
+
+    private AsyncSnapshotCache() {
+    }
+
+    public static SnapshotPathNavigationRegion.SectionCache sectionCacheForWorld(final String worldName, final long tickId) {
+        return INSTANCE.sectionCache(worldName, tickId);
+    }
+
+    public static void invalidateWorld(final String worldName) {
+        Objects.requireNonNull(worldName, "worldName");
+        INSTANCE.sectionCaches.remove(worldName);
+    }
+
+    private SnapshotPathNavigationRegion.SectionCache sectionCache(final String worldName, final long tickId) {
+        Objects.requireNonNull(worldName, "worldName");
+        SnapshotPathNavigationRegion.SectionCache cache = this.sectionCaches.computeIfAbsent(
+            worldName,
+            key -> new SnapshotPathNavigationRegion.SectionCache()
+        );
+        cache.reset(tickId);
+        return cache;
+    }
+}
