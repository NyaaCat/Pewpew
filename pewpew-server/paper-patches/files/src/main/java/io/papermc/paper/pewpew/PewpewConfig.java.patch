+package io.papermc.paper.pewpew;
+
+import com.google.common.base.Throwables;
+import java.io.File;
+import java.io.IOException;
+import java.util.logging.Level;
+import java.util.logging.Logger;
+import org.bukkit.configuration.InvalidConfigurationException;
+import org.bukkit.configuration.file.YamlConfiguration;
+
+public final class PewpewConfig {
+    private static final Logger LOGGER = Logger.getLogger("Pewpew");
+    private static final String HEADER = """
+        This is the Pewpew configuration file.
+        Feature flags here control Pewpew-specific patches and can be used to
+        verify which capabilities are active on startup.
+        """;
+    private static final int CURRENT_VERSION = 1;
+    private static final String CONFIG_VERSION_PATH = "config-version";
+
+    private static File configFile;
+    private static YamlConfiguration config;
+
+    public static boolean asyncPathfinding;
+    public static boolean asyncSensors;
+    public static boolean worldTickCoordinator;
+    public static boolean worldTickCoordinatorTesting;
+    public static boolean asyncPoolTesting;
+    public static boolean tickThreadHardThrow;
+
+    public static int asyncPoolWorkers;
+    public static int asyncPoolQueueLimit;
+    public static int asyncPathfindingMaxPending;
+    public static int worldTickCoordinatorWorkers;
+    public static long worldTickCoordinatorStallThresholdNanos;
+
+    private PewpewConfig() {
+    }
+
+    public static void init(final File file) {
+        configFile = file;
+        config = new YamlConfiguration();
+        try {
+            config.load(configFile);
+        } catch (IOException ignored) {
+        } catch (InvalidConfigurationException ex) {
+            LOGGER.log(Level.SEVERE, "Could not load pewpew.yml, please correct your syntax errors", ex);
+            throw Throwables.propagate(ex);
+        }
+
+        config.options().header(HEADER);
+        config.options().copyDefaults(true);
+
+        final int version = getInt(CONFIG_VERSION_PATH, CURRENT_VERSION);
+        if (version != CURRENT_VERSION) {
+            set(CONFIG_VERSION_PATH, CURRENT_VERSION);
+        }
+
+        asyncPathfinding = getBoolean("features.async-pathfinding", false);
+        asyncSensors = getBoolean("features.async-sensors", false);
+        worldTickCoordinator = getBoolean("features.world-tick-coordinator", false);
+        worldTickCoordinatorTesting = getBoolean("features.world-tick-coordinator-testing", false);
+        asyncPoolTesting = getBoolean("features.async-pool-testing", false);
+        tickThreadHardThrow = getBoolean("features.tick-thread-hard-throw", true);
+
+        asyncPoolWorkers = getInt("settings.async-pool-workers", -1);
+        asyncPoolQueueLimit = getInt("settings.async-pool-queue-limit", -1);
+        asyncPathfindingMaxPending = getInt("settings.async-pathfinding-max-pending", -1);
+        worldTickCoordinatorWorkers = getInt("settings.world-tick-coordinator-workers", -1);
+        worldTickCoordinatorStallThresholdNanos = getLong("settings.world-tick-coordinator-stall-threshold-nanos", 50_000_000L);
+
+        applySystemProperties();
+        logFeatureFlags();
+
+        try {
+            config.save(configFile);
+        } catch (IOException ex) {
+            LOGGER.log(Level.SEVERE, "Could not save " + configFile, ex);
+        }
+    }
+
+    private static void applySystemProperties() {
+        setBooleanProperty("pewpew.asyncPathfinding", asyncPathfinding);
+        setBooleanProperty("pewpew.asyncSensors", asyncSensors);
+        setBooleanProperty("pewpew.worldTickCoordinator", worldTickCoordinator);
+        setBooleanProperty("pewpew.worldTickCoordinator.testing", worldTickCoordinatorTesting);
+        setBooleanProperty("pewpew.async.testing", asyncPoolTesting);
+        if (tickThreadHardThrow) {
+            System.clearProperty("pewpew.disableHardThrow");
+        } else {
+            System.setProperty("pewpew.disableHardThrow", "true");
+        }
+
+        setOptionalIntProperty("pewpew.async.workers", asyncPoolWorkers);
+        setOptionalIntProperty("pewpew.async.queueLimit", asyncPoolQueueLimit);
+        setOptionalIntProperty("pewpew.asyncPathfinding.maxPending", asyncPathfindingMaxPending);
+        setOptionalIntProperty("pewpew.worldTickCoordinator.workers", worldTickCoordinatorWorkers);
+        setOptionalLongProperty("pewpew.worldTickCoordinator.stallThresholdNanos", worldTickCoordinatorStallThresholdNanos);
+    }
+
+    private static void logFeatureFlags() {
+        LOGGER.info("Pewpew feature flags:");
+        logFlag("async-pathfinding", asyncPathfinding);
+        logFlag("async-sensors", asyncSensors);
+        logFlag("world-tick-coordinator", worldTickCoordinator);
+        logFlag("world-tick-coordinator-testing", worldTickCoordinatorTesting);
+        logFlag("async-pool-testing", asyncPoolTesting);
+        logFlag("tick-thread-hard-throw", tickThreadHardThrow);
+        LOGGER.info("Pewpew settings: async-pool-workers=" + formatOptional(asyncPoolWorkers)
+            + " async-pool-queue-limit=" + formatOptional(asyncPoolQueueLimit)
+            + " async-pathfinding-max-pending=" + formatOptional(asyncPathfindingMaxPending));
+        LOGGER.info("Pewpew settings: world-tick-workers=" + formatOptional(worldTickCoordinatorWorkers)
+            + " world-tick-stall-threshold-nanos=" + worldTickCoordinatorStallThresholdNanos);
+    }
+
+    private static void logFlag(final String name, final boolean enabled) {
+        LOGGER.info("  " + name + ": " + (enabled ? "enabled" : "disabled"));
+    }
+
+    private static String formatOptional(final int value) {
+        if (value <= 0) {
+            return "default";
+        }
+        return Integer.toString(value);
+    }
+
+    private static void setBooleanProperty(final String key, final boolean value) {
+        System.setProperty(key, Boolean.toString(value));
+    }
+
+    private static void setOptionalIntProperty(final String key, final int value) {
+        if (value <= 0) {
+            System.clearProperty(key);
+            return;
+        }
+        System.setProperty(key, Integer.toString(value));
+    }
+
+    private static void setOptionalLongProperty(final String key, final long value) {
+        if (value <= 0L) {
+            System.clearProperty(key);
+            return;
+        }
+        System.setProperty(key, Long.toString(value));
+    }
+
+    private static void set(final String path, final Object val) {
+        config.set(path, val);
+    }
+
+    private static boolean getBoolean(final String path, final boolean def) {
+        config.addDefault(path, def);
+        return config.getBoolean(path, def);
+    }
+
+    private static int getInt(final String path, final int def) {
+        config.addDefault(path, def);
+        return config.getInt(path, def);
+    }
+
+    private static long getLong(final String path, final long def) {
+        config.addDefault(path, def);
+        return config.getLong(path, def);
+    }
+}
