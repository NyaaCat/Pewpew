diff --git a/src/main/java/io/papermc/paper/PaperBootstrap.java b/src/main/java/io/papermc/paper/PaperBootstrap.java
index 314cb08dd0af4a4abc3db4368df731cfe06a1df7..a6dccc500250f5a2324a0efa75c792d3882ca314 100644
--- a/src/main/java/io/papermc/paper/PaperBootstrap.java
+++ b/src/main/java/io/papermc/paper/PaperBootstrap.java
@@ -1,6 +1,8 @@
 package io.papermc.paper;
 
+import io.papermc.paper.pewpew.PewpewConfig;
 import io.papermc.paper.pewpew.WorldTickCoordinator;
+import java.io.File;
 import java.util.List;
 import joptsimple.OptionSet;
 import net.minecraft.SharedConstants;
@@ -19,6 +21,7 @@ public final class PaperBootstrap {
 
         getStartupVersionMessages().forEach(LOGGER::info);
 
+        PewpewConfig.init(new File("pewpew.yml"));
         WorldTickCoordinator.get().init(); // Pewpew - no-op unless enabled
 
         Main.main(options);
