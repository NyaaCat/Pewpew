From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Sun, 18 Jan 2026 16:54:07 +0000
Subject: [PATCH] Use TickThread for world tick workers


diff --git a/src/main/java/io/papermc/paper/pewpew/WorldTickCoordinator.java b/src/main/java/io/papermc/paper/pewpew/WorldTickCoordinator.java
index 6440dc8d500d8d696baaa0794897f26aa9ae337f..660041dcc420c5506d8aabe80354d0debfca42c9 100644
--- a/src/main/java/io/papermc/paper/pewpew/WorldTickCoordinator.java
+++ b/src/main/java/io/papermc/paper/pewpew/WorldTickCoordinator.java
@@ -1,5 +1,6 @@
 package io.papermc.paper.pewpew;
 
+import ca.spottedleaf.moonrise.common.util.TickThread;
 import java.util.Collections;
 import java.util.LinkedHashMap;
 import java.util.List;
@@ -251,7 +252,7 @@ public final class WorldTickCoordinator {
             Math.max(1, Runtime.getRuntime().availableProcessors() - 1)
         ));
         final ThreadFactory factory = runnable -> {
-            final Thread thread = new Thread(runnable, THREAD_NAME_PREFIX + this.threadIds.incrementAndGet());
+            final Thread thread = new TickThread(runnable, THREAD_NAME_PREFIX + this.threadIds.incrementAndGet());
             if (Boolean.getBoolean(TESTING_PROPERTY)) {
                 thread.setDaemon(true);
             }
