diff --git a/src/test/java/io/papermc/paper/pewpew/perf/BaselineLoopPerfTest.java b/src/test/java/io/papermc/paper/pewpew/perf/BaselineLoopPerfTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..581002dfb719b1b434e82d9854bfe76d4e246024
--- /dev/null
+++ b/src/test/java/io/papermc/paper/pewpew/perf/BaselineLoopPerfTest.java
@@ -0,0 +1,28 @@
+package io.papermc.paper.pewpew.perf;
+
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+@Tag("PewpewPerf")
+class BaselineLoopPerfTest {
+    @Test
+    void baselineLoop() throws Exception {
+        final int iterations = 1_000_000;
+        long value = 0L;
+        final long start = System.nanoTime();
+        for (int i = 0; i < iterations; i++) {
+            value += (long) i * 31L;
+        }
+        final long durationNanos = System.nanoTime() - start;
+
+        final PerfReport.PerfSample sample = PerfReport.sample(
+            "BaselineLoop",
+            iterations,
+            durationNanos
+        );
+        PerfReport.handleBaselineOrCompare(sample);
+        assertTrue(value > 0L);
+    }
+}
diff --git a/src/test/java/io/papermc/paper/pewpew/perf/PerfReport.java b/src/test/java/io/papermc/paper/pewpew/perf/PerfReport.java
