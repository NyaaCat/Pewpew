     private static final String STALL_THRESHOLD_PROPERTY = "pewpew.worldTickCoordinator.stallThresholdNanos";
+    private static final String WORKER_COUNT_PROPERTY = "pewpew.worldTickCoordinator.workers";
     private static final long DEFAULT_STALL_THRESHOLD_NANOS = 50_000_000L;
+    private static final String THREAD_NAME_PREFIX = "Pewpew-Tick-";
 
     private static final WorldTickCoordinator INSTANCE = new WorldTickCoordinator();
 
@@ -22,6 +31,9 @@ public final class WorldTickCoordinator {
     private final ConcurrentHashMap<String, WorldTickMetrics> metricsByWorld = new ConcurrentHashMap<>();
     private final LongAdder stallCount = new LongAdder();
     private final AtomicLong maxStallNanos = new AtomicLong();
+    private final AtomicInteger threadIds = new AtomicInteger();
+    private final Object executorLock = new Object();
