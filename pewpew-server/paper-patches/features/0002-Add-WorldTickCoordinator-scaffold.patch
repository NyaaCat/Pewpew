diff --git a/src/main/java/io/papermc/paper/pewpew/WorldTickCoordinator.java b/src/main/java/io/papermc/paper/pewpew/WorldTickCoordinator.java
new file mode 100644
index 0000000000000000000000000000000000000000..bec0bcce84f49e5ee6545055c72998af27248c0f
--- /dev/null
+++ b/src/main/java/io/papermc/paper/pewpew/WorldTickCoordinator.java
@@ -0,0 +1,31 @@
+package io.papermc.paper.pewpew;
+
+import java.util.concurrent.atomic.AtomicBoolean;
+
+public final class WorldTickCoordinator {
+    private static final boolean ENABLED = Boolean.getBoolean("pewpew.worldTickCoordinator");
+    private static final WorldTickCoordinator INSTANCE = new WorldTickCoordinator();
+
+    private final AtomicBoolean initialized = new AtomicBoolean();
+
+    private WorldTickCoordinator() {
+    }
+
+    public static WorldTickCoordinator get() {
+        return INSTANCE;
+    }
+
+    public static boolean isEnabled() {
+        return ENABLED;
+    }
+
+    public void init() {
+        if (!ENABLED) {
+            return;
+        }
+        if (!this.initialized.compareAndSet(false, true)) {
+            return;
+        }
+        // Placeholder for future initialization.
+    }
+}
diff --git a/src/test/java/io/papermc/paper/pewpew/WorldTickCoordinatorPerfTest.java b/src/test/java/io/papermc/paper/pewpew/WorldTickCoordinatorPerfTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..949479a92d7112e14fe2719bd92a6c1624097b58
--- /dev/null
+++ b/src/test/java/io/papermc/paper/pewpew/WorldTickCoordinatorPerfTest.java
@@ -0,0 +1,47 @@
+package io.papermc.paper.pewpew;
+
+import java.net.URISyntaxException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.time.Instant;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class WorldTickCoordinatorPerfTest {
+    @Test
+    void initPerfReport() throws Exception {
+        final int iterations = 1_000_000;
+        final long start = System.nanoTime();
+        for (int i = 0; i < iterations; i++) {
+            WorldTickCoordinator.get().init();
+        }
+        final long durationNanos = System.nanoTime() - start;
+        final long nanosPerOp = durationNanos / Math.max(1, iterations);
+
+        final Path root = findRepoRoot();
+        final Path report = root.resolve("tmp/pewpew/findings/perf-report.md");
+        Files.createDirectories(report.getParent());
+        final String line = String.format(
+            "- %s WorldTickCoordinator.init iterations=%d duration_ns=%d ns_per_op=%d%n",
+            Instant.now(),
+            iterations,
+            durationNanos,
+            nanosPerOp
+        );
+        Files.writeString(report, line, StandardOpenOption.CREATE, StandardOpenOption.APPEND);
+        assertTrue(nanosPerOp > 0);
+    }
+
+    private static Path findRepoRoot() throws URISyntaxException {
+        Path dir = Path.of(WorldTickCoordinatorPerfTest.class.getProtectionDomain().getCodeSource().getLocation().toURI());
+        while (dir != null) {
+            if (Files.exists(dir.resolve("settings.gradle.kts"))) {
+                return dir;
+            }
+            dir = dir.getParent();
+        }
+        throw new IllegalStateException("Unable to locate repo root for perf report");
+    }
+}
diff --git a/src/test/java/io/papermc/paper/pewpew/WorldTickCoordinatorTest.java b/src/test/java/io/papermc/paper/pewpew/WorldTickCoordinatorTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..65c5848a5506f0d1bd239348e4d63e0b60fca9ea
--- /dev/null
+++ b/src/test/java/io/papermc/paper/pewpew/WorldTickCoordinatorTest.java
@@ -0,0 +1,21 @@
+package io.papermc.paper.pewpew;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class WorldTickCoordinatorTest {
+    @Test
+    void enabledFlagMatchesSystemProperty() {
+        assertEquals(Boolean.getBoolean("pewpew.worldTickCoordinator"), WorldTickCoordinator.isEnabled());
+    }
+
+    @Test
+    void initIsIdempotent() {
+        assertDoesNotThrow(() -> {
+            WorldTickCoordinator.get().init();
+            WorldTickCoordinator.get().init();
+        });
+    }
+}
