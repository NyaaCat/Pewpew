@@ -0,0 +1,34 @@
+package io.papermc.paper.pewpew;
+
+import io.papermc.paper.pewpew.perf.PerfReport;
+import java.util.Map;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+@Tag("PewpewPerf")
+@Tag("PewpewOnly")
+class SnapshotManagerPerfTest {
+    @Test
+    void buildAndPublishPerf() throws Exception {
+        SnapshotManager manager = new SnapshotManager();
+        Map<String, Long> versions = Map.of("chunks", 1L, "entities", 2L);
+
+        final int iterations = 50_000;
+        final long start = System.nanoTime();
+        for (int i = 0; i < iterations; i++) {
+            SnapshotManager.Snapshot snapshot = manager.buildSnapshot("snapshot_perf_world", i, i, versions);
+            manager.publishSnapshot(snapshot);
+        }
+        final long durationNanos = System.nanoTime() - start;
+
+        final PerfReport.PerfSample sample = PerfReport.sample(
+            "SnapshotManager.buildPublish",
+            iterations,
+            durationNanos
+        );
+        PerfReport.handleBaselineOrCompare(sample, false);
+        assertTrue(sample.nanosPerOp() > 0L);
+    }
+}
diff --git a/src/test/java/io/papermc/paper/pewpew/SnapshotManagerTest.java b/src/test/java/io/papermc/paper/pewpew/SnapshotManagerTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..ac68dd2d927b4c63b588fd3bd08d0025587fe50c
--- /dev/null
+++ b/src/test/java/io/papermc/paper/pewpew/SnapshotManagerTest.java
@@ -0,0 +1,30 @@
+package io.papermc.paper.pewpew;
+
+import java.util.HashMap;
+import java.util.Map;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+@Normal
+class SnapshotManagerTest {
+    @Test
+    void publishAndClearSnapshot() {
+        SnapshotManager manager = new SnapshotManager();
+        Map<String, Long> versions = new HashMap<>();
+        versions.put("chunks", 1L);
+
+        SnapshotManager.Snapshot snapshot = manager.buildSnapshot("snapshot_world", 12L, 7L, versions);
+        versions.put("chunks", 2L);
+        manager.publishSnapshot(snapshot);
+
+        SnapshotManager.Snapshot stored = manager.getSnapshot("snapshot_world");
+        assertEquals(12L, stored.tickId());
+        assertEquals(7L, stored.generationId());
+        assertEquals(1L, stored.versionMarkers().get("chunks"));
+
+        manager.clearWorld("snapshot_world");
+        assertNull(manager.getSnapshot("snapshot_world"));
+    }
