diff --git a/src/main/java/io/papermc/paper/pewpew/CommitQueue.java b/src/main/java/io/papermc/paper/pewpew/CommitQueue.java
new file mode 100644
index 0000000000000000000000000000000000000000..634741cfa40b0d49ec5883462fab2d04f9b3a3e9
--- /dev/null
+++ b/src/main/java/io/papermc/paper/pewpew/CommitQueue.java
@@ -0,0 +1,23 @@
+package io.papermc.paper.pewpew;
+
+import java.util.Objects;
+import java.util.concurrent.ConcurrentLinkedQueue;
+
+public final class CommitQueue {
+    private final ConcurrentLinkedQueue<Runnable> queue = new ConcurrentLinkedQueue<>();
+
+    public void enqueue(final Runnable commit) {
+        Objects.requireNonNull(commit, "commit");
+        this.queue.add(commit);
+    }
+
+    public int drain() {
+        int executed = 0;
+        Runnable task;
+        while ((task = this.queue.poll()) != null) {
+            task.run();
+            executed++;
+        }
+        return executed;
+    }
+}
diff --git a/src/main/java/io/papermc/paper/pewpew/SnapshotManager.java b/src/main/java/io/papermc/paper/pewpew/SnapshotManager.java
new file mode 100644
index 0000000000000000000000000000000000000000..6b969a852880741ca60fe19a08b8f629fd923a44
--- /dev/null
+++ b/src/main/java/io/papermc/paper/pewpew/SnapshotManager.java
@@ -0,0 +1,38 @@
+package io.papermc.paper.pewpew;
+
+import java.util.Collections;
+import java.util.Map;
+import java.util.Objects;
+import java.util.concurrent.ConcurrentHashMap;
+
+public final class SnapshotManager {
+    private final ConcurrentHashMap<String, Snapshot> snapshots = new ConcurrentHashMap<>();
+
+    public Snapshot buildSnapshot(final String worldName, final long tickId, final long generationId, final Map<String, Long> versionMarkers) {
+        Objects.requireNonNull(worldName, "worldName");
+        Objects.requireNonNull(versionMarkers, "versionMarkers");
+        return new Snapshot(worldName, tickId, generationId, Collections.unmodifiableMap(Map.copyOf(versionMarkers)));
+    }
+
+    public void publishSnapshot(final Snapshot snapshot) {
+        Objects.requireNonNull(snapshot, "snapshot");
+        this.snapshots.put(snapshot.worldName(), snapshot);
+    }
+
+    public Snapshot getSnapshot(final String worldName) {
+        Objects.requireNonNull(worldName, "worldName");
+        return this.snapshots.get(worldName);
+    }
+
+    public void clearWorld(final String worldName) {
+        Objects.requireNonNull(worldName, "worldName");
+        this.snapshots.remove(worldName);
+    }
+
+    public record Snapshot(String worldName, long tickId, long generationId, Map<String, Long> versionMarkers) {
+        public Snapshot {
+            Objects.requireNonNull(worldName, "worldName");
+            Objects.requireNonNull(versionMarkers, "versionMarkers");
+        }
+    }
+}
diff --git a/src/test/java/io/papermc/paper/pewpew/CommitQueuePerfTest.java b/src/test/java/io/papermc/paper/pewpew/CommitQueuePerfTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..d5b4b142506aa8ebd2656c5b3f0af50cf50a9f71
--- /dev/null
+++ b/src/test/java/io/papermc/paper/pewpew/CommitQueuePerfTest.java
@@ -0,0 +1,34 @@
+package io.papermc.paper.pewpew;
+
+import io.papermc.paper.pewpew.perf.PerfReport;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+@Tag("PewpewPerf")
+@Tag("PewpewOnly")
+class CommitQueuePerfTest {
+    @Test
+    void enqueueDrainPerf() throws Exception {
+        CommitQueue queue = new CommitQueue();
+        Runnable task = () -> {};
+
+        final int iterations = 20_000;
+        final long start = System.nanoTime();
+        for (int i = 0; i < iterations; i++) {
+            queue.enqueue(task);
+            queue.enqueue(task);
+            queue.drain();
+        }
+        final long durationNanos = System.nanoTime() - start;
+
+        final PerfReport.PerfSample sample = PerfReport.sample(
+            "CommitQueue.enqueueDrain",
+            iterations,
+            durationNanos
+        );
+        PerfReport.handleBaselineOrCompare(sample, false);
+        assertTrue(sample.nanosPerOp() > 0L);
+    }
+}
diff --git a/src/test/java/io/papermc/paper/pewpew/CommitQueueTest.java b/src/test/java/io/papermc/paper/pewpew/CommitQueueTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..f3560bbfe69737345d32197d280f291aedcd0138
--- /dev/null
+++ b/src/test/java/io/papermc/paper/pewpew/CommitQueueTest.java
@@ -0,0 +1,24 @@
+package io.papermc.paper.pewpew;
+
+import java.util.ArrayList;
+import java.util.List;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+@Normal
+class CommitQueueTest {
+    @Test
+    void drainsInOrder() {
+        CommitQueue queue = new CommitQueue();
+        List<Integer> order = new ArrayList<>();
+
+        queue.enqueue(() -> order.add(1));
+        queue.enqueue(() -> order.add(2));
+
+        int executed = queue.drain();
+        assertEquals(2, executed);
+        assertEquals(List.of(1, 2), order);
+    }
+}
