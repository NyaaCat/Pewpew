diff --git a/src/test/java/io/papermc/paper/pewpew/RedstoneWireThreadLocalTest.java b/src/test/java/io/papermc/paper/pewpew/RedstoneWireThreadLocalTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..a695556072f13bf6963a5f6a662f6fe61b64f772
--- /dev/null
+++ b/src/test/java/io/papermc/paper/pewpew/RedstoneWireThreadLocalTest.java
@@ -0,0 +1,33 @@
+package io.papermc.paper.pewpew;
+
+import java.util.concurrent.atomic.AtomicReference;
+import net.minecraft.world.level.block.RedStoneWireBlock;
+import net.minecraft.world.level.block.state.BlockBehaviour;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+
+@Normal
+class RedstoneWireThreadLocalTest {
+    @Test
+    void shouldSignalIsThreadLocal() throws InterruptedException {
+        RedStoneWireBlock wire = new RedStoneWireBlock(BlockBehaviour.Properties.of());
+        wire.setShouldSignal(false);
+        AtomicReference<Boolean> initial = new AtomicReference<>();
+        AtomicReference<Boolean> after = new AtomicReference<>();
+
+        Thread thread = new Thread(() -> {
+            initial.set(wire.shouldSignal());
+            wire.setShouldSignal(true);
+            after.set(wire.shouldSignal());
+        });
+        thread.start();
+        thread.join();
+
+        assertEquals(Boolean.TRUE, initial.get());
+        assertEquals(Boolean.TRUE, after.get());
+        assertFalse(wire.shouldSignal());
+    }
+}
