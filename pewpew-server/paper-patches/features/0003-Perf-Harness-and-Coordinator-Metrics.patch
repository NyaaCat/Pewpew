diff --git a/src/test/java/io/papermc/paper/pewpew/perf/PerfReport.java b/src/test/java/io/papermc/paper/pewpew/perf/PerfReport.java
new file mode 100644
index 0000000..d9269d3
--- /dev/null
+++ b/src/test/java/io/papermc/paper/pewpew/perf/PerfReport.java
@@ -0,0 +1,145 @@
+package io.papermc.paper.pewpew.perf;
+
+import java.io.IOException;
+import java.io.Reader;
+import java.io.Writer;
+import java.net.URISyntaxException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.time.Instant;
+import java.util.Objects;
+import java.util.Properties;
+
+public final class PerfReport {
+    private static final String MODE_PROPERTY = "pewpew.perf.mode";
+    private static final String BASELINE_FILE_PROPERTY = "pewpew.perf.baselineFile";
+    private static final String ALLOWED_REGRESSION_PROPERTY = "pewpew.perf.allowedRegressionPercent";
+
+    private static final String MODE_BASELINE = "baseline";
+    private static final String MODE_COMPARE = "compare";
+
+    private static final double DEFAULT_ALLOWED_REGRESSION_PERCENT = 5.0;
+
+    private PerfReport() {
+    }
+
+    public static PerfSample sample(final String id, final long iterations, final long durationNanos) {
+        final long safeIterations = Math.max(1, iterations);
+        final long nanosPerOp = durationNanos / safeIterations;
+        return new PerfSample(id, safeIterations, durationNanos, nanosPerOp);
+    }
+
+    public static void writeReport(final PerfSample sample, final Long baselineNanosPerOp) throws IOException, URISyntaxException {
+        final Path report = reportFile();
+        Files.createDirectories(report.getParent());
+        final String baselineText = baselineNanosPerOp == null ? "n/a" : baselineNanosPerOp.toString();
+        final String line = String.format(
+            "- %s %s iterations=%d duration_ns=%d ns_per_op=%d baseline_ns_per_op=%s%n",
+            Instant.now(),
+            sample.id(),
+            sample.iterations(),
+            sample.durationNanos(),
+            sample.nanosPerOp(),
+            baselineText
+        );
+        Files.writeString(report, line, StandardOpenOption.CREATE, StandardOpenOption.APPEND);
+    }
+
+    public static void handleBaselineOrCompare(final PerfSample sample) throws IOException, URISyntaxException {
+        final String mode = mode();
+        if (MODE_BASELINE.equals(mode)) {
+            writeBaseline(sample);
+            writeReport(sample, sample.nanosPerOp());
+            return;
+        }
+        if (!MODE_COMPARE.equals(mode)) {
+            throw new IllegalStateException("Unknown perf mode: " + mode);
+        }
+        final Long baseline = readBaseline(sample.id());
+        if (baseline == null) {
+            throw new IllegalStateException("Missing baseline for " + sample.id() + "; run with -D" + MODE_PROPERTY + "=baseline on vanilla Paper");
+        }
+        writeReport(sample, baseline);
+        assertNoRegression(sample, baseline);
+    }
+
+    private static String mode() {
+        return System.getProperty(MODE_PROPERTY, MODE_COMPARE).trim();
+    }
+
+    private static void writeBaseline(final PerfSample sample) throws IOException, URISyntaxException {
+        final Properties properties = loadBaselineProperties();
+        properties.setProperty(sample.id(), Long.toString(sample.nanosPerOp()));
+        final Path baseline = baselineFile();
+        Files.createDirectories(baseline.getParent());
+        try (Writer writer = Files.newBufferedWriter(baseline)) {
+            properties.store(writer, "Pewpew perf baselines (ns per op)");
+        }
+    }
+
+    private static Long readBaseline(final String id) throws IOException, URISyntaxException {
+        final Properties properties = loadBaselineProperties();
+        final String value = properties.getProperty(id);
+        if (value == null) {
+            return null;
+        }
+        return Long.parseLong(value.trim());
+    }
+
+    private static Properties loadBaselineProperties() throws IOException, URISyntaxException {
+        final Properties properties = new Properties();
+        final Path baseline = baselineFile();
+        if (!Files.exists(baseline)) {
+            return properties;
+        }
+        try (Reader reader = Files.newBufferedReader(baseline)) {
+            properties.load(reader);
+        }
+        return properties;
+    }
+
+    private static void assertNoRegression(final PerfSample sample, final long baselineNanosPerOp) {
+        final double allowedPercent = Double.parseDouble(System.getProperty(
+            ALLOWED_REGRESSION_PROPERTY,
+            Double.toString(DEFAULT_ALLOWED_REGRESSION_PERCENT)
+        ));
+        final long allowed = Math.round(baselineNanosPerOp * (1.0 + (allowedPercent / 100.0)));
+        if (sample.nanosPerOp() > allowed) {
+            throw new AssertionError(
+                "Perf regression for " + sample.id() + ": baseline=" + baselineNanosPerOp
+                    + " ns/op, current=" + sample.nanosPerOp() + " ns/op, allowed=" + allowed
+                    + " ns/op (" + allowedPercent + "% over baseline)"
+            );
+        }
+    }
+
+    private static Path baselineFile() throws URISyntaxException {
+        final String override = System.getProperty(BASELINE_FILE_PROPERTY);
+        if (override != null && !override.isBlank()) {
+            return Path.of(override);
+        }
+        return repoRoot().resolve("tmp/pewpew/findings/perf-baseline.properties");
+    }
+
+    private static Path reportFile() throws URISyntaxException {
+        return repoRoot().resolve("tmp/pewpew/findings/perf-report.md");
+    }
+
+    private static Path repoRoot() throws URISyntaxException {
+        Path dir = Path.of(PerfReport.class.getProtectionDomain().getCodeSource().getLocation().toURI());
+        while (dir != null) {
+            if (Files.exists(dir.resolve("settings.gradle.kts"))) {
+                return dir;
+            }
+            dir = dir.getParent();
+        }
+        throw new IllegalStateException("Unable to locate repo root for perf report");
+    }
+
+    public record PerfSample(String id, long iterations, long durationNanos, long nanosPerOp) {
+        public PerfSample {
+            Objects.requireNonNull(id, "id");
+        }
+    }
+}
