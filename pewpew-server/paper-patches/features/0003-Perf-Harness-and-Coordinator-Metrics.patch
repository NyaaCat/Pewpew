@@ -1,12 +1,27 @@
 package io.papermc.paper.pewpew;
 
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Objects;
+import java.util.concurrent.ConcurrentHashMap;
 import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.concurrent.atomic.LongAdder;
 
 public final class WorldTickCoordinator {
-    private static final boolean ENABLED = Boolean.getBoolean("pewpew.worldTickCoordinator");
+    private static final String ENABLE_PROPERTY = "pewpew.worldTickCoordinator";
+    private static final String TESTING_PROPERTY = "pewpew.worldTickCoordinator.testing";
+    private static final String STALL_THRESHOLD_PROPERTY = "pewpew.worldTickCoordinator.stallThresholdNanos";
+    private static final long DEFAULT_STALL_THRESHOLD_NANOS = 50_000_000L;
+
     private static final WorldTickCoordinator INSTANCE = new WorldTickCoordinator();
 
     private final AtomicBoolean initialized = new AtomicBoolean();
+    private final ConcurrentHashMap<String, WorldTickMetrics> metricsByWorld = new ConcurrentHashMap<>();
+    private final LongAdder stallCount = new LongAdder();
+    private final AtomicLong maxStallNanos = new AtomicLong();
 
     private WorldTickCoordinator() {
     }
@@ -16,11 +31,15 @@ public final class WorldTickCoordinator {
     }
 
     public static boolean isEnabled() {
-        return ENABLED;
+        return Boolean.getBoolean(ENABLE_PROPERTY);
+    }
+
+    private static boolean isActive() {
+        return isEnabled() || Boolean.getBoolean(TESTING_PROPERTY);
     }
 
     public void init() {
-        if (!ENABLED) {
+        if (!isEnabled()) {
             return;
         }
         if (!this.initialized.compareAndSet(false, true)) {
@@ -28,4 +47,122 @@ public final class WorldTickCoordinator {
         }
         // Placeholder for future initialization.
     }
+
+    public long recordWorldTickStart(final String worldName) {
+        if (!isActive()) {
+            return 0L;
+        }
+        final WorldTickMetrics metrics = this.metricsFor(worldName);
+        metrics.tickCount.increment();
+        return System.nanoTime();
+    }
+
+    public void recordWorldTickEnd(final String worldName, final long startNanos) {
+        if (!isActive()) {
+            return;
+        }
+        final long duration = System.nanoTime() - startNanos;
+        this.recordWorldTickDuration(worldName, duration);
+    }
+
+    public void recordWorldTickDuration(final String worldName, final long durationNanos) {
+        if (!isActive()) {
+            return;
+        }
+        final WorldTickMetrics metrics = this.metricsFor(worldName);
+        metrics.totalTickNanos.add(durationNanos);
+        updateMax(metrics.maxTickNanos, durationNanos);
+    }
+
+    public void recordQueueDepth(final String worldName, final int depth) {
+        if (!isActive()) {
+            return;
+        }
+        final WorldTickMetrics metrics = this.metricsFor(worldName);
+        metrics.lastQueueDepth.set(depth);
+        updateMax(metrics.maxQueueDepth, depth);
+    }
+
+    public void recordCoordinatorWait(final long durationNanos) {
+        if (!isActive()) {
+            return;
+        }
+        final long threshold = Long.getLong(STALL_THRESHOLD_PROPERTY, DEFAULT_STALL_THRESHOLD_NANOS);
+        if (durationNanos >= threshold) {
+            this.stallCount.increment();
+            updateMax(this.maxStallNanos, durationNanos);
+        }
+    }
+
+    public WorldTickSnapshot snapshot() {
+        final Map<String, WorldTickStats> worldStats = new LinkedHashMap<>();
+        for (final Map.Entry<String, WorldTickMetrics> entry : this.metricsByWorld.entrySet()) {
+            final WorldTickMetrics metrics = entry.getValue();
+            worldStats.put(entry.getKey(), metrics.snapshot());
+        }
+        return new WorldTickSnapshot(
+            Collections.unmodifiableMap(worldStats),
+            this.stallCount.sum(),
+            this.maxStallNanos.get()
+        );
+    }
+
+    private WorldTickMetrics metricsFor(final String worldName) {
+        Objects.requireNonNull(worldName, "worldName");
+        return this.metricsByWorld.computeIfAbsent(worldName, key -> new WorldTickMetrics());
+    }
+
+    private static void updateMax(final AtomicLong target, final long value) {
+        long prev;
+        do {
+            prev = target.get();
+            if (value <= prev) {
+                return;
+            }
+        } while (!target.compareAndSet(prev, value));
+    }
+
+    private static void updateMax(final AtomicInteger target, final int value) {
+        int prev;
+        do {
+            prev = target.get();
+            if (value <= prev) {
+                return;
+            }
+        } while (!target.compareAndSet(prev, value));
+    }
+
+    private static final class WorldTickMetrics {
+        private final LongAdder tickCount = new LongAdder();
+        private final LongAdder totalTickNanos = new LongAdder();
+        private final AtomicLong maxTickNanos = new AtomicLong();
+        private final AtomicInteger lastQueueDepth = new AtomicInteger();
+        private final AtomicInteger maxQueueDepth = new AtomicInteger();
+
+        private WorldTickStats snapshot() {
+            return new WorldTickStats(
+                this.tickCount.sum(),
+                this.totalTickNanos.sum(),
+                this.maxTickNanos.get(),
+                this.lastQueueDepth.get(),
+                this.maxQueueDepth.get()
+            );
+        }
+    }
+
+    public record WorldTickStats(
+        long tickCount,
+        long totalTickNanos,
+        long maxTickNanos,
+        int lastQueueDepth,
+        int maxQueueDepth
+    ) {
+    }
+
+    public record WorldTickSnapshot(
+        Map<String, WorldTickStats> worldStats,
+        long stallCount,
+        long maxStallNanos
+    ) {
+    }
 }
