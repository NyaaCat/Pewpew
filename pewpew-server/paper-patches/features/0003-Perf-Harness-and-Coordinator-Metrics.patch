@@ -0,0 +1,32 @@
+package io.papermc.paper.pewpew;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+
+class WorldTickCoordinatorMetricsTest {
+    @Test
+    void recordsTickAndQueueMetrics() {
+        System.setProperty("pewpew.worldTickCoordinator.testing", "true");
+
+        final WorldTickCoordinator coordinator = WorldTickCoordinator.get();
+        final String worldName = "test_world_metrics";
+        coordinator.recordWorldTickStart(worldName);
+        coordinator.recordWorldTickDuration(worldName, 1_000_000L);
+        coordinator.recordQueueDepth(worldName, 4);
+        coordinator.recordQueueDepth(worldName, 2);
+        coordinator.recordCoordinatorWait(60_000_000L);
+
+        final WorldTickCoordinator.WorldTickSnapshot snapshot = coordinator.snapshot();
+        final WorldTickCoordinator.WorldTickStats stats = snapshot.worldStats().get(worldName);
+        assertNotNull(stats, "missing stats for " + worldName);
+        assertEquals(1L, stats.tickCount());
+        assertEquals(1_000_000L, stats.totalTickNanos());
+        assertEquals(1_000_000L, stats.maxTickNanos());
+        assertEquals(2, stats.lastQueueDepth());
+        assertEquals(4, stats.maxQueueDepth());
+        assertEquals(1L, snapshot.stallCount());
+        assertEquals(60_000_000L, snapshot.maxStallNanos());
+    }
+}
