From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Phoenix <w@m.ac>
Date: Mon, 19 Jan 2026 02:32:00 +0900
Subject: [PATCH] Invalidate async caches on world unload


diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index a3acc8ef64942eb298069ab182efb98740d9b293..2eca83525be4050ec0b432acdfb569a426ed41a2 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -15,6 +15,7 @@ import com.mojang.serialization.Lifecycle;
 import io.papermc.paper.configuration.PaperServerConfiguration;
 import io.papermc.paper.configuration.ServerConfiguration;
 import io.papermc.paper.pewpew.PewpewConfig;
+import io.papermc.paper.pewpew.AsyncSensorService;
 import io.papermc.paper.pewpew.WorldTickCoordinator;
 import it.unimi.dsi.fastutil.objects.Object2IntOpenHashMap;
 import java.awt.image.BufferedImage;
@@ -70,6 +71,7 @@ import net.minecraft.server.dedicated.DedicatedServer;
 import net.minecraft.server.dedicated.DedicatedServerProperties;
 import net.minecraft.server.dedicated.DedicatedServerSettings;
 import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.level.pathfinder.AsyncPathService;
 import net.minecraft.server.level.ServerPlayer;
 import net.minecraft.server.level.TicketType;
 import net.minecraft.server.players.IpBanListEntry;
@@ -1469,6 +1471,10 @@ public final class CraftServer implements Server {
 
         this.worlds.remove(world.getName().toLowerCase(Locale.ROOT));
         this.console.removeLevel(handle);
+        String worldName = handle.getWorld().getName();
+        WorldTickCoordinator.get().invalidateWorld(worldName);
+        AsyncSensorService.invalidateWorld(worldName);
+        AsyncPathService.invalidateWorld(worldName);
         return true;
     }
 
