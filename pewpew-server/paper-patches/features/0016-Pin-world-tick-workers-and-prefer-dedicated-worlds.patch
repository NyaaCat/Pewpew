+    @Test
+    void worldAssignmentsStayStableAcrossDispatches() throws Exception {
+        final String previousEnabled = System.getProperty("pewpew.worldTickCoordinator");
+        final String previousTesting = System.getProperty("pewpew.worldTickCoordinator.testing");
+        final String previousWorkers = System.getProperty("pewpew.worldTickCoordinator.workers");
+        final WorldTickCoordinator coordinator = WorldTickCoordinator.get();
+        try {
+            System.setProperty("pewpew.worldTickCoordinator", "true");
+            System.setProperty("pewpew.worldTickCoordinator.testing", "true");
+            System.setProperty("pewpew.worldTickCoordinator.workers", "2");
+            coordinator.init();
+
+            final Map<String, String> firstThreads = new ConcurrentHashMap<>();
+            final Map<String, Runnable> tasks = new LinkedHashMap<>();
+            tasks.put("world_one", () -> firstThreads.put("world_one", Thread.currentThread().getName()));
+            tasks.put("world_two", () -> firstThreads.put("world_two", Thread.currentThread().getName()));
+
+            coordinator.dispatchWorldTicks(tasks).await();
+
+            final Map<String, String> secondThreads = new ConcurrentHashMap<>();
+            final Map<String, Runnable> secondTasks = new LinkedHashMap<>();
+            secondTasks.put("world_one", () -> secondThreads.put("world_one", Thread.currentThread().getName()));
+            secondTasks.put("world_two", () -> secondThreads.put("world_two", Thread.currentThread().getName()));
+
+            coordinator.dispatchWorldTicks(secondTasks).await();
+
+            assertEquals(firstThreads.get("world_one"), secondThreads.get("world_one"));
+            assertEquals(firstThreads.get("world_two"), secondThreads.get("world_two"));
+        } finally {
+            coordinator.shutdownForTesting();
+            restoreProperty("pewpew.worldTickCoordinator", previousEnabled);
+            restoreProperty("pewpew.worldTickCoordinator.testing", previousTesting);
+            restoreProperty("pewpew.worldTickCoordinator.workers", previousWorkers);
+        }
+    }
