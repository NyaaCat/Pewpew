+    private Set<String> refreshDedicatedWorlds() {
+        final String raw = System.getProperty(DEDICATED_WORLDS_PROPERTY, "");
+        if (raw.equals(this.dedicatedWorldsRaw)) {
+            return this.dedicatedWorlds;
+        }
+        final Set<String> parsed = parseDedicatedWorlds(raw);
+        this.dedicatedWorldsRaw = raw;
+        this.dedicatedWorlds = parsed;
+        for (final WorldTickWorker worker : this.workers) {
+            worker.recalculateDedicatedWorlds(parsed);
+        }
+        return parsed;
+    }
+
+    private static Set<String> parseDedicatedWorlds(final String raw) {
+        if (raw == null || raw.isBlank()) {
+            return Set.of();
+        }
+        final Set<String> worlds = new LinkedHashSet<>();
+        final String[] parts = raw.split(",");
+        for (final String part : parts) {
+            final String trimmed = part.trim();
+            if (trimmed.isEmpty()) {
+                continue;
+            }
+            worlds.add(trimmed);
+        }
+        return Set.copyOf(worlds);
+    }
+
+    private WorldTickWorker selectWorker(final boolean dedicatedWorld) {
+        if (this.workers.isEmpty()) {
+            return null;
+        }
+        if (dedicatedWorld) {
+            return selectWorkerForDedicated();
+        }
+        return selectWorkerForShared();
+    }
+
+    private WorldTickWorker selectWorkerForDedicated() {
+        WorldTickWorker best = null;
+        int bestCount = Integer.MAX_VALUE;
+        boolean bestHasDedicated = true;
+        for (final WorldTickWorker worker : this.workers) {
+            final int count = worker.worldCount();
+            if (count == 0) {
+                return worker;
+            }
+            final boolean hasDedicated = worker.hasDedicatedWorlds();
+            if (count < bestCount || (count == bestCount && !hasDedicated && bestHasDedicated)) {
+                best = worker;
+                bestCount = count;
+                bestHasDedicated = hasDedicated;
+            } else if (count == bestCount && hasDedicated == bestHasDedicated && best != null && worker.id < best.id) {
+                best = worker;
+            }
+        }
+        return best;
+    }
+
+    private WorldTickWorker selectWorkerForShared() {
+        WorldTickWorker best = null;
+        int bestCount = Integer.MAX_VALUE;
+        for (final WorldTickWorker worker : this.workers) {
+            if (worker.hasDedicatedWorlds()) {
+                continue;
+            }
+            final int count = worker.worldCount();
+            if (count < bestCount) {
+                best = worker;
+                bestCount = count;
+            } else if (count == bestCount && best != null && worker.id < best.id) {
+                best = worker;
+            }
+        }
+        if (best != null) {
+            return best;
+        }
+        bestCount = Integer.MAX_VALUE;
+        for (final WorldTickWorker worker : this.workers) {
+            final int count = worker.worldCount();
+            if (count < bestCount) {
+                best = worker;
+                bestCount = count;
+            } else if (count == bestCount && best != null && worker.id < best.id) {
+                best = worker;
+            }
+        }
+        return best;
     }
 
