+    private static final class WorldTickWorker implements Runnable {
+        private final int id;
+        private final BlockingQueue<Runnable> queue;
+        private final TickThread thread;
+        private final AtomicBoolean running;
+        private final Set<String> worlds = new LinkedHashSet<>();
+        private int dedicatedWorlds;
+
+        private WorldTickWorker(final int id, final boolean daemon) {
+            this.id = id;
+            this.queue = new LinkedBlockingQueue<>();
+            this.running = new AtomicBoolean(true);
+            this.thread = new TickThread(this, THREAD_NAME_PREFIX + id);
+            if (daemon) {
+                this.thread.setDaemon(true);
+            }
+            this.thread.start();
+        }
+
+        private boolean enqueue(final Runnable task) {
+            if (!this.running.get()) {
+                return false;
+            }
+            this.queue.add(task);
+            return true;
+        }
+
+        private int queueSize() {
+            return this.queue.size();
+        }
+
+        private void shutdown() {
+            this.running.set(false);
+            this.thread.interrupt();
+        }
+
+        private boolean hasWorlds() {
+            return !this.worlds.isEmpty();
+        }
+
+        private int worldCount() {
+            return this.worlds.size();
+        }
+
+        private boolean hasDedicatedWorlds() {
+            return this.dedicatedWorlds > 0;
+        }
+
+        private void assignWorld(final String worldName, final boolean dedicated) {
+            if (this.worlds.add(worldName) && dedicated) {
+                this.dedicatedWorlds++;
+            }
+        }
+
+        private void removeWorld(final String worldName, final boolean dedicated) {
+            if (this.worlds.remove(worldName) && dedicated) {
+                this.dedicatedWorlds = Math.max(0, this.dedicatedWorlds - 1);
+            }
+        }
+
+        private void recalculateDedicatedWorlds(final Set<String> dedicated) {
+            int count = 0;
+            for (final String worldName : this.worlds) {
+                if (dedicated.contains(worldName)) {
+                    count++;
+                }
+            }
+            this.dedicatedWorlds = count;
+        }
+
+        @Override
+        public void run() {
+            while (this.running.get() || !this.queue.isEmpty()) {
+                try {
+                    final Runnable task = this.queue.poll(250L, TimeUnit.MILLISECONDS);
+                    if (task != null) {
+                        task.run();
+                    }
+                } catch (final InterruptedException ex) {
+                    if (!this.running.get()) {
+                        break;
+                    }
+                }
+            }
+        }
+    }
 }
