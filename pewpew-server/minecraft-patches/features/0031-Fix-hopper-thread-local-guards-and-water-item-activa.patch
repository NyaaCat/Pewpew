 public abstract class BlockEntity {
-    static boolean ignoreBlockEntityUpdates; // Paper - Perf: Optimize Hoppers
+    // Pewpew start - thread-local hopper update suppression under parallel world ticking
+    private static final ThreadLocal<Boolean> IGNORE_BLOCK_ENTITY_UPDATES = ThreadLocal.withInitial(() -> Boolean.FALSE);
