From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Phoenix Bot <w@c.at>
Date: Sun, 8 Feb 2026 07:06:36 +0000
Subject: [PATCH] Ignore LockettePro-tagged containers in hopper search


diff --git a/net/minecraft/world/level/block/entity/HopperBlockEntity.java b/net/minecraft/world/level/block/entity/HopperBlockEntity.java
index ce6b64e00a0a13ebdceda56d975d79f60c26b86d..6c1b1c29c5d80523393a9c593a78593bf03a4549 100644
--- a/net/minecraft/world/level/block/entity/HopperBlockEntity.java
+++ b/net/minecraft/world/level/block/entity/HopperBlockEntity.java
@@ -7,6 +7,7 @@ import net.minecraft.core.Direction;
 import net.minecraft.core.NonNullList;
 import net.minecraft.network.chat.Component;
 import net.minecraft.tags.BlockTags;
+import net.minecraft.world.CompoundContainer;
 import net.minecraft.world.Container;
 import net.minecraft.world.ContainerHelper;
 import net.minecraft.world.WorldlyContainer;
@@ -146,6 +147,7 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
     private static final int HOPPER_EMPTY = 0;
     private static final int HOPPER_HAS_ITEMS = 1;
     private static final int HOPPER_IS_FULL = 2;
+    private static final String LOCKETTEPRO_LOCKED_CONTAINER_PDC_KEY = "lockettepro:locked_container";
 
     private static int getFullState(final HopperBlockEntity hopper) {
         hopper.unpackLootTable(null);
@@ -378,6 +380,20 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
         }
     }
 
+    private static boolean hasLocketteLockedContainerPdc(final BlockEntity blockEntity) {
+        return blockEntity.persistentDataContainer.getTag(LOCKETTEPRO_LOCKED_CONTAINER_PDC_KEY) != null;
+    }
+
+    private static boolean shouldIgnoreForLockettePdc(final @Nullable Container container) {
+        if (container instanceof BlockEntity blockEntity) {
+            return hasLocketteLockedContainerPdc(blockEntity);
+        }
+        if (container instanceof CompoundContainer compoundContainer) {
+            return shouldIgnoreForLockettePdc(compoundContainer.container1) || shouldIgnoreForLockettePdc(compoundContainer.container2);
+        }
+        return false;
+    }
+
     private static boolean allMatch(Container container, Direction direction, java.util.function.BiPredicate<ItemStack, Integer> test) {
         if (container instanceof WorldlyContainer worldlyContainer) {
             for (int slot : worldlyContainer.getSlotsForFace(direction)) {
@@ -637,33 +653,41 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
         // Paper start
         BlockPos searchPosition = blockPos.relative(self.facing);
         Container inventory = getContainerAt(level, searchPosition);
+        if (shouldIgnoreForLockettePdc(inventory)) {
+            inventory = null;
+        }
         if (org.bukkit.event.inventory.HopperInventorySearchEvent.getHandlerList().getRegisteredListeners().length == 0) return inventory;
 
         org.bukkit.craftbukkit.block.CraftBlock hopper = org.bukkit.craftbukkit.block.CraftBlock.at(level, blockPos);
         org.bukkit.craftbukkit.block.CraftBlock searchBlock = org.bukkit.craftbukkit.block.CraftBlock.at(level, searchPosition);
-        return HopperBlockEntity.runHopperInventorySearchEvent(
+        Container eventResult = HopperBlockEntity.runHopperInventorySearchEvent(
             inventory,
             hopper,
             searchBlock,
             org.bukkit.event.inventory.HopperInventorySearchEvent.ContainerType.DESTINATION
         );
+        return shouldIgnoreForLockettePdc(eventResult) ? null : eventResult;
         // Paper end
     }
 
     private static @Nullable Container getSourceContainer(final Level level, final Hopper hopper, final BlockPos pos, final BlockState state) {
         // Paper start
-        final Container inventory = HopperBlockEntity.getContainerAt(level, pos, state, hopper.getLevelX(), hopper.getLevelY() + 1.0, hopper.getLevelZ());
+        Container inventory = HopperBlockEntity.getContainerAt(level, pos, state, hopper.getLevelX(), hopper.getLevelY() + 1.0, hopper.getLevelZ());
+        if (shouldIgnoreForLockettePdc(inventory)) {
+            inventory = null;
+        }
         if (org.bukkit.event.inventory.HopperInventorySearchEvent.getHandlerList().getRegisteredListeners().length == 0) return inventory;
 
         final BlockPos hopperPos = BlockPos.containing(hopper.getLevelX(), hopper.getLevelY(), hopper.getLevelZ());
         org.bukkit.craftbukkit.block.CraftBlock hopperBlock = org.bukkit.craftbukkit.block.CraftBlock.at(level, hopperPos);
         org.bukkit.craftbukkit.block.CraftBlock containerBlock = org.bukkit.craftbukkit.block.CraftBlock.at(level, hopperPos.above());
-        return HopperBlockEntity.runHopperInventorySearchEvent(
+        Container eventResult = HopperBlockEntity.runHopperInventorySearchEvent(
             inventory,
             hopperBlock,
             containerBlock,
             org.bukkit.event.inventory.HopperInventorySearchEvent.ContainerType.SOURCE
         );
+        return shouldIgnoreForLockettePdc(eventResult) ? null : eventResult;
         // Paper end
     }
 
@@ -699,7 +723,8 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
         if (!level.spigotConfig.hopperCanLoadChunks && !level.hasChunkAt(pos)) return null; // Spigot
         Block block = state.getBlock();
         if (block instanceof WorldlyContainerHolder) {
-            return ((WorldlyContainerHolder)block).getContainer(state, level, pos);
+            Container container = ((WorldlyContainerHolder)block).getContainer(state, level, pos);
+            return shouldIgnoreForLockettePdc(container) ? null : container;
         }
 
         if (state.hasBlockEntity() && level.getBlockEntity(pos) instanceof Container container) {
@@ -707,7 +732,7 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
                 container = ChestBlock.getContainer((ChestBlock)block, state, level, pos, true);
             }
 
-            return container;
+            return shouldIgnoreForLockettePdc(container) ? null : container;
         } else {
             return null;
         }
