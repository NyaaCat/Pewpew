From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Sat, 17 Jan 2026 17:48:48 +0000
Subject: [PATCH] Parallelize world tick dispatch via coordinator


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index cc35c6271c98615a486422d0490145227626bd85..f142cf80d2458c36e492143db4cb551955ed767b 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1836,26 +1836,67 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         this.updateEffectiveRespawnData();
 
         this.isIteratingOverLevels = true; // Paper - Throw exception on world create while being ticked
-        for (ServerLevel level : this.getAllLevels()) {
-            level.hasPhysicsEvent = org.bukkit.event.block.BlockPhysicsEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - BlockPhysicsEvent
-            level.hasEntityMoveEvent = io.papermc.paper.event.entity.EntityMoveEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - Add EntityMoveEvent
-            level.updateLagCompensationTick(); // Paper - lag compensation
-            net.minecraft.world.level.block.entity.HopperBlockEntity.skipHopperEvents = level.paperConfig().hopper.disableMoveEvent || org.bukkit.event.inventory.InventoryMoveItemEvent.getHandlerList().getRegisteredListeners().length == 0; // Paper - Perf: Optimize Hoppers
-            profiler.push(() -> level + " " + level.dimension().identifier());
-            profiler.push("tick");
+        if (io.papermc.paper.pewpew.WorldTickCoordinator.isEnabled()) {
+            Map<String, Runnable> worldTasks = Maps.newLinkedHashMap();
+            for (ServerLevel level : this.getAllLevels()) {
+                final String worldKey = level.dimension().identifier().toString();
+                worldTasks.put(worldKey, () -> {
+                    ProfilerFiller worldProfiler = Profiler.get();
+                    level.hasPhysicsEvent = org.bukkit.event.block.BlockPhysicsEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - BlockPhysicsEvent
+                    level.hasEntityMoveEvent = io.papermc.paper.event.entity.EntityMoveEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - Add EntityMoveEvent
+                    level.updateLagCompensationTick(); // Paper - lag compensation
+                    net.minecraft.world.level.block.entity.HopperBlockEntity.skipHopperEvents = level.paperConfig().hopper.disableMoveEvent || org.bukkit.event.inventory.InventoryMoveItemEvent.getHandlerList().getRegisteredListeners().length == 0; // Paper - Perf: Optimize Hoppers
+                    worldProfiler.push(() -> level + " " + level.dimension().identifier());
+
+                    io.papermc.paper.pewpew.WorldTickCoordinator.get().drainCommits(List.of(level.getWorld().getName()));
+                    worldProfiler.push("tick");
+
+                    try {
+                        level.tick(haveTime);
+                    } catch (Throwable t) {
+                        CrashReport report = CrashReport.forThrowable(t, "Exception ticking world");
+                        level.fillReportDetails(report);
+                        throw new ReportedException(report);
+                    }
 
+                    worldProfiler.pop();
+                    worldProfiler.pop();
+                    level.explosionDensityCache.clear(); // Paper - Optimize explosions
+                });
+            }
+            io.papermc.paper.pewpew.WorldTickCoordinator.TickBarrier barrier =
+                io.papermc.paper.pewpew.WorldTickCoordinator.get().dispatchWorldTicks(worldTasks);
             try {
-                level.tick(haveTime);
-            } catch (Throwable t) {
-                CrashReport report = CrashReport.forThrowable(t, "Exception ticking world");
-                level.fillReportDetails(report);
-                throw new ReportedException(report);
+                barrier.await();
+            } catch (InterruptedException interrupted) {
+                Thread.currentThread().interrupt();
+                throw new RuntimeException("Interrupted while waiting for world ticks", interrupted);
             }
+        } else {
+            for (ServerLevel level : this.getAllLevels()) {
+                level.hasPhysicsEvent = org.bukkit.event.block.BlockPhysicsEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - BlockPhysicsEvent
+                level.hasEntityMoveEvent = io.papermc.paper.event.entity.EntityMoveEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - Add EntityMoveEvent
+                level.updateLagCompensationTick(); // Paper - lag compensation
+                net.minecraft.world.level.block.entity.HopperBlockEntity.skipHopperEvents = level.paperConfig().hopper.disableMoveEvent || org.bukkit.event.inventory.InventoryMoveItemEvent.getHandlerList().getRegisteredListeners().length == 0; // Paper - Perf: Optimize Hoppers
+                profiler.push(() -> level + " " + level.dimension().identifier());
 
-            profiler.pop();
-            profiler.pop();
-            level.explosionDensityCache.clear(); // Paper - Optimize explosions
+                io.papermc.paper.pewpew.WorldTickCoordinator.get().drainCommits(List.of(level.getWorld().getName()));
+                profiler.push("tick");
+
+                try {
+                    level.tick(haveTime);
+                } catch (Throwable t) {
+                    CrashReport report = CrashReport.forThrowable(t, "Exception ticking world");
+                    level.fillReportDetails(report);
+                    throw new ReportedException(report);
+                }
+
+                profiler.pop();
+                profiler.pop();
+                level.explosionDensityCache.clear(); // Paper - Optimize explosions
+            }
         }
+        io.papermc.paper.pewpew.WorldTickCoordinator.get().drainGlobalCommits();
         this.isIteratingOverLevels = false; // Paper - Throw exception on world create while being ticked
 
         profiler.popPush("connection");
