+                                            batchCache.computeIfAbsent(pair.getSecond().asLong(), key -> new AcquirePoi.JitteredLinearRetry(level.getRandom(), now));
+                                        }
+                                    }
+                                }
+                            )
+                        ) {
+                            return true;
+                        }
                         Path path = findPathToPois(body, poiPositions);
+                        if (path != null && AsyncPath.isPending(path)) {
+                            return true;
+                        }
                         if (path != null && path.canReach()) {
                             BlockPos targetPos = path.getTarget();
                             poiManager.getType(targetPos).ifPresent(type -> {
