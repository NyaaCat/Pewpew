+        if (this.level instanceof ServerLevel serverLevel) {
+            Path asyncPath = AsyncPathService.schedule(serverLevel, this.mob, this, targets, fromPos, radius, reachRange, maxPathLength);
+            if (asyncPath != null) {
+                profiler.pop();
+                this.targetPos = asyncPath.getTarget();
+                this.reachRange = reachRange;
+                this.resetStuckTimeout();
