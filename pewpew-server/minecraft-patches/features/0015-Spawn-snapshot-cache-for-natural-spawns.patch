+    private static final class SpawnChunkSnapshot {
+        private final ServerLevel level;
+        private final LevelChunk chunk;
+        private final int minBlockX;
+        private final int maxBlockX;
+        private final int minBlockZ;
+        private final int maxBlockZ;
+        private final PalettedContainer<BlockState>[] sectionStates;
+        private final long[] sectionVersions;
+        private final Long2ObjectOpenHashMap<Holder<Biome>> biomeCache = new Long2ObjectOpenHashMap<>();
+        private final SpawnSnapshotLevelReader levelReader;
+
+        private SpawnChunkSnapshot(final ServerLevel level, final LevelChunk chunk) {
+            this.level = level;
+            this.chunk = chunk;
+            ChunkPos chunkPos = chunk.getPos();
+            this.minBlockX = chunkPos.getMinBlockX();
+            this.maxBlockX = chunkPos.getMaxBlockX();
+            this.minBlockZ = chunkPos.getMinBlockZ();
+            this.maxBlockZ = chunkPos.getMaxBlockZ();
+            this.sectionStates = new PalettedContainer[chunk.getSections().length];
+            this.sectionVersions = new long[this.sectionStates.length];
+            Arrays.fill(this.sectionVersions, Long.MIN_VALUE);
+            this.levelReader = new SpawnSnapshotLevelReader(level, this);
+        }
+
+        private static @Nullable SpawnChunkSnapshot create(final ServerLevel level, final LevelChunk chunk) {
+            return Boolean.getBoolean(SPAWN_SNAPSHOT_CACHE_PROPERTY) ? new SpawnChunkSnapshot(level, chunk) : null;
+        }
+
+        private boolean contains(final BlockPos pos) {
+            return this.containsXZ(pos.getX(), pos.getZ());
+        }
+
+        private boolean containsXZ(final int x, final int z) {
+            return x >= this.minBlockX && x <= this.maxBlockX && z >= this.minBlockZ && z <= this.maxBlockZ;
+        }
+
+        private BlockState getBlockState(final BlockPos pos) {
+            if (!this.contains(pos)) {
+                return this.level.getBlockState(pos);
+            }
+            if (this.chunk.isOutsideBuildHeight(pos)) {
+                return Blocks.AIR.defaultBlockState();
+            }
+            int sectionIndex = this.chunk.getSectionIndex(pos.getY());
+            if (sectionIndex < 0 || sectionIndex >= this.sectionStates.length) {
+                return Blocks.AIR.defaultBlockState();
+            }
+            LevelChunkSection section = this.chunk.getSection(sectionIndex);
+            if (section.hasOnlyAir()) {
+                return Blocks.AIR.defaultBlockState();
+            }
+            long version = section.getChangeVersion();
+            PalettedContainer<BlockState> states = this.sectionStates[sectionIndex];
+            if (states == null || this.sectionVersions[sectionIndex] != version) {
+                states = section.states.copy();
+                this.sectionStates[sectionIndex] = states;
+                this.sectionVersions[sectionIndex] = version;
+            }
+            return states.get(pos.getX() & 15, pos.getY() & 15, pos.getZ() & 15);
+        }
+
+        private @Nullable BlockState getBlockStateIfLoaded(final BlockPos pos) {
+            if (!this.contains(pos)) {
+                return this.level.getBlockStateIfLoaded(pos);
+            }
+            return this.getBlockState(pos);
+        }
+
+        private FluidState getFluidState(final BlockPos pos) {
+            return this.getBlockState(pos).getFluidState();
+        }
+
+        private @Nullable FluidState getFluidIfLoaded(final BlockPos pos) {
+            BlockState state = this.getBlockStateIfLoaded(pos);
+            return state == null ? null : state.getFluidState();
+        }
+
+        private Holder<Biome> getBiome(final BlockPos pos) {
+            if (!this.contains(pos)) {
+                return this.level.getBiome(pos);
+            }
+            long key = pos.asLong();
+            Holder<Biome> cached = this.biomeCache.get(key);
+            if (cached != null) {
+                return cached;
+            }
+            Holder<Biome> biome = this.chunk.getNoiseBiome(
+                QuartPos.fromBlock(pos.getX()),
+                QuartPos.fromBlock(pos.getY()),
+                QuartPos.fromBlock(pos.getZ())
+            );
+            this.biomeCache.put(key, biome);
+            return biome;
+        }
+
+        private int getHeight(final Heightmap.Types type, final int x, final int z) {
+            return this.chunk.getHeight(type, x, z);
+        }
+    }
+
+    private static final class SpawnSnapshotLevelReader implements LevelReader {
+        private final ServerLevel level;
+        private final SpawnChunkSnapshot snapshot;
+
+        private SpawnSnapshotLevelReader(final ServerLevel level, final SpawnChunkSnapshot snapshot) {
+            this.level = level;
+            this.snapshot = snapshot;
+        }
+
+        @Override
+        public BlockEntity getBlockEntity(final BlockPos pos) {
+            return this.level.getBlockEntity(pos);
+        }
+
+        @Override
+        public BlockState getBlockState(final BlockPos pos) {
+            return this.snapshot.contains(pos) ? this.snapshot.getBlockState(pos) : this.level.getBlockState(pos);
+        }
+
+        @Override
+        public @Nullable BlockState getBlockStateIfLoaded(final BlockPos pos) {
+            return this.snapshot.contains(pos) ? this.snapshot.getBlockStateIfLoaded(pos) : this.level.getBlockStateIfLoaded(pos);
+        }
+
+        @Override
+        public @Nullable FluidState getFluidIfLoaded(final BlockPos pos) {
+            return this.snapshot.contains(pos) ? this.snapshot.getFluidIfLoaded(pos) : this.level.getFluidIfLoaded(pos);
+        }
+
+        @Override
+        public FluidState getFluidState(final BlockPos pos) {
+            return this.snapshot.contains(pos) ? this.snapshot.getFluidState(pos) : this.level.getFluidState(pos);
+        }
+
+        @Override
+        public int getHeight(final Heightmap.Types heightmapType, final int x, final int z) {
+            return this.snapshot.containsXZ(x, z) ? this.snapshot.getHeight(heightmapType, x, z) : this.level.getHeight(heightmapType, x, z);
+        }
+
+        @Override
+        public Holder<Biome> getBiome(final BlockPos pos) {
+            return this.snapshot.contains(pos) ? this.snapshot.getBiome(pos) : this.level.getBiome(pos);
+        }
+
+        @Override
+        public ChunkAccess getChunk(final int x, final int z, final ChunkStatus chunkStatus, final boolean requireChunk) {
+            return this.level.getChunk(x, z, chunkStatus, requireChunk);
+        }
+
+        @Override
+        public @Nullable ChunkAccess getChunkIfLoadedImmediately(final int x, final int z) {
+            return this.level.getChunkIfLoadedImmediately(x, z);
+        }
+
+        @Override
+        public boolean hasChunk(final int chunkX, final int chunkZ) {
+            return this.level.hasChunk(chunkX, chunkZ);
+        }
+
+        @Override
+        public int getSkyDarken() {
+            return this.level.getSkyDarken();
+        }
+
+        @Override
+        public BiomeManager getBiomeManager() {
+            return this.level.getBiomeManager();
+        }
+
+        @Override
+        public Holder<Biome> getUncachedNoiseBiome(final int x, final int y, final int z) {
+            return this.level.getUncachedNoiseBiome(x, y, z);
+        }
+
+        @Override
+        public RegistryAccess registryAccess() {
+            return this.level.registryAccess();
+        }
+
+        @Override
+        public FeatureFlagSet enabledFeatures() {
+            return this.level.enabledFeatures();
+        }
+
+        @Override
+        public EnvironmentAttributeReader environmentAttributes() {
+            return this.level.environmentAttributes();
+        }
+
+        @Override
+        public boolean isClientSide() {
+            return this.level.isClientSide();
+        }
+
+        @Override
+        public int getSeaLevel() {
+            return this.level.getSeaLevel();
+        }
+
+        @Override
+        public DimensionType dimensionType() {
+            return this.level.dimensionType();
+        }
+
+        @Override
+        public LevelLightEngine getLightEngine() {
+            return this.level.getLightEngine();
+        }
+
+        @Override
+        public WorldBorder getWorldBorder() {
+            return this.level.getWorldBorder();
+        }
+
+        @Override
+        public List<VoxelShape> getEntityCollisions(final @Nullable Entity entity, final AABB collisionBox) {
+            return this.level.getEntityCollisions(entity, collisionBox);
+        }
+
+        @Override
+        public BlockGetter getChunkForCollisions(final int chunkX, final int chunkZ) {
+            return this.level.getChunkForCollisions(chunkX, chunkZ);
+        }
+    }
