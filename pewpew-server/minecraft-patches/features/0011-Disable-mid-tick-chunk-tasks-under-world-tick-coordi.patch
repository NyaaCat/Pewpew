From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Sun, 18 Jan 2026 23:30:57 +0000
Subject: [PATCH] Disable mid-tick chunk tasks under world tick coordinator


diff --git a/net/minecraft/server/level/ServerChunkCache.java b/net/minecraft/server/level/ServerChunkCache.java
index af67b07722bb0125acd081dab767d7e7b360623b..f7122f640a7c68aecc3c105b29dc01372d972c2a 100644
--- a/net/minecraft/server/level/ServerChunkCache.java
+++ b/net/minecraft/server/level/ServerChunkCache.java
@@ -176,7 +176,9 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
 
             // call mid-tick tasks for chunk system
             if ((i & 7) == 0) {
-                ((ca.spottedleaf.moonrise.patches.chunk_system.server.ChunkSystemMinecraftServer)this.level.getServer()).moonrise$executeMidTickTasks();
+                if (!io.papermc.paper.pewpew.WorldTickCoordinator.isEnabled()) {
+                    ((ca.spottedleaf.moonrise.patches.chunk_system.server.ChunkSystemMinecraftServer)this.level.getServer()).moonrise$executeMidTickTasks();
+                }
                 continue;
             }
         }
diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index cf574b16cca17f7ff24583acc88d5666aecf7697..29b229835897f68ad922b59017923e9915073a65 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -343,6 +343,9 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
 
     @Override
     public final void moonrise$midTickTasks() {
+        if (io.papermc.paper.pewpew.WorldTickCoordinator.isEnabled()) {
+            return;
+        }
         ((ca.spottedleaf.moonrise.patches.chunk_system.server.ChunkSystemMinecraftServer)this.server).moonrise$executeMidTickTasks();
     }
 
@@ -1310,7 +1313,9 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
         }
         // Paper start - rewrite chunk system
         if ((++this.tickedBlocksOrFluids & 7L) != 0L) {
-            ((ca.spottedleaf.moonrise.patches.chunk_system.server.ChunkSystemMinecraftServer)this.server).moonrise$executeMidTickTasks();
+            if (!io.papermc.paper.pewpew.WorldTickCoordinator.isEnabled()) {
+                ((ca.spottedleaf.moonrise.patches.chunk_system.server.ChunkSystemMinecraftServer)this.server).moonrise$executeMidTickTasks();
+            }
         }
         // Paper end - rewrite chunk system
 
@@ -1323,7 +1328,9 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
         }
         // Paper start - rewrite chunk system
         if ((++this.tickedBlocksOrFluids & 7L) != 0L) {
-            ((ca.spottedleaf.moonrise.patches.chunk_system.server.ChunkSystemMinecraftServer)this.server).moonrise$executeMidTickTasks();
+            if (!io.papermc.paper.pewpew.WorldTickCoordinator.isEnabled()) {
+                ((ca.spottedleaf.moonrise.patches.chunk_system.server.ChunkSystemMinecraftServer)this.server).moonrise$executeMidTickTasks();
+            }
         }
         // Paper end - rewrite chunk system
 
diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
index b382133d5602cfa6192e43993447af09f6c7aed9..cba57a804cb7b2ce62748c28bf92b44da8610098 100644
--- a/net/minecraft/world/level/Level.java
+++ b/net/minecraft/world/level/Level.java
@@ -1410,7 +1410,9 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
                 tickingBlockEntity.tick();
                 // Paper start - rewrite chunk system
                 if ((++tickedEntities & 7) == 0) {
-                    ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemLevel)(Level)(Object)this).moonrise$midTickTasks();
+                    if (!io.papermc.paper.pewpew.WorldTickCoordinator.isEnabled()) {
+                        ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemLevel)(Level)(Object)this).moonrise$midTickTasks();
+                    }
                 }
                 // Paper end - rewrite chunk system
             }
@@ -1432,7 +1434,9 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
             entity.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.DISCARD);
             // Paper end - Prevent block entity and entity crashes
         }
-        this.moonrise$midTickTasks(); // Paper - rewrite chunk system
+        if (!io.papermc.paper.pewpew.WorldTickCoordinator.isEnabled()) {
+            this.moonrise$midTickTasks(); // Paper - rewrite chunk system
+        }
     }
 
     // Paper start - Option to prevent armor stands from doing entity lookups
