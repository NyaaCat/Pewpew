From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Thu, 29 Jan 2026 03:55:00 +0000
Subject: [PATCH] Defer scheduled functions under world tick coordinator


diff --git a/net/minecraft/world/level/timers/FunctionCallback.java b/net/minecraft/world/level/timers/FunctionCallback.java
index 8c0c30328ecbce01df378ec253ee238a1027d035..db0f6341ad60f255d654053145ec0335e45f56a8 100644
--- a/net/minecraft/world/level/timers/FunctionCallback.java
+++ b/net/minecraft/world/level/timers/FunctionCallback.java
@@ -3,7 +3,6 @@ package net.minecraft.world.level.timers;
 import com.mojang.serialization.MapCodec;
 import com.mojang.serialization.codecs.RecordCodecBuilder;
 import net.minecraft.commands.CommandSourceStack;
-import net.minecraft.commands.functions.CommandFunction;
 import net.minecraft.resources.ResourceLocation;
 import net.minecraft.server.MinecraftServer;
 import net.minecraft.server.ServerFunctionManager;
@@ -17,7 +16,15 @@ public record FunctionCallback(ResourceLocation functionId) implements TimerCall
     public void handle(MinecraftServer obj, TimerQueue<MinecraftServer> manager, long gameTime) {
         ServerFunctionManager functions = obj.getFunctions();
         functions.get(this.functionId)
-            .ifPresent(commandFunction -> functions.execute((CommandFunction<CommandSourceStack>)commandFunction, functions.getGameLoopSender()));
+            .ifPresent(commandFunction -> {
+                final Runnable execute = () -> functions.execute(commandFunction, functions.getGameLoopSender());
+                if (io.papermc.paper.pewpew.WorldTickCoordinator.isEnabled()
+                    && !io.papermc.paper.util.MCUtil.isMainServerThread()) {
+                    io.papermc.paper.pewpew.WorldTickCoordinator.get().enqueueGlobalCommit(execute);
+                    return;
+                }
+                execute.run();
+            });
     }
 
     @Override
