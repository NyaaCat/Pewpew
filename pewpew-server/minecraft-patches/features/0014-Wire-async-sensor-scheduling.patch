From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Phoenix <w@m.ac>
Date: Mon, 19 Jan 2026 02:25:00 +0900
Subject: [PATCH] Wire async sensor scheduling


diff --git a/net/minecraft/world/entity/ai/sensing/NearestLivingEntitySensor.java b/net/minecraft/world/entity/ai/sensing/NearestLivingEntitySensor.java
index 3578ece216827fd5d8c1206c689fc608e97b50df..932f1d2a7a7318a8037cca4cc678db898f3b2a44 100644
--- a/net/minecraft/world/entity/ai/sensing/NearestLivingEntitySensor.java
+++ b/net/minecraft/world/entity/ai/sensing/NearestLivingEntitySensor.java
@@ -1,6 +1,7 @@
 package net.minecraft.world.entity.ai.sensing;
 
 import com.google.common.collect.ImmutableSet;
+import io.papermc.paper.pewpew.AsyncSensorService;
 import java.util.Comparator;
 import java.util.List;
 import java.util.Set;
@@ -18,6 +19,9 @@ public class NearestLivingEntitySensor<T extends LivingEntity> extends Sensor<T>
         double followRange = body.getAttributeValue(Attributes.FOLLOW_RANGE);
         AABB boundingBox = body.getBoundingBox().inflate(followRange, followRange, followRange);
         List<LivingEntity> livingEntities = level.getEntitiesOfClass(LivingEntity.class, boundingBox, mob -> mob != body && mob.isAlive());
+        if (!livingEntities.isEmpty() && AsyncSensorService.scheduleNearestLivingEntities(level, body, livingEntities, followRange)) {
+            return;
+        }
         livingEntities.sort(Comparator.comparingDouble(body::distanceToSqr));
         Brain<?> brain = body.getBrain();
         brain.setMemory(MemoryModuleType.NEAREST_LIVING_ENTITIES, livingEntities);
diff --git a/net/minecraft/world/entity/ai/sensing/PlayerSensor.java b/net/minecraft/world/entity/ai/sensing/PlayerSensor.java
index 22f58ba0bce5db69c7bcea76d40bac6079f5581a..d9cdf440c2fcfc3bdd5253682e46e68c2f961571 100644
--- a/net/minecraft/world/entity/ai/sensing/PlayerSensor.java
+++ b/net/minecraft/world/entity/ai/sensing/PlayerSensor.java
@@ -1,6 +1,7 @@
 package net.minecraft.world.entity.ai.sensing;
 
 import com.google.common.collect.ImmutableSet;
+import io.papermc.paper.pewpew.AsyncSensorService;
 import java.util.Comparator;
 import java.util.List;
 import java.util.Set;
@@ -26,12 +27,16 @@ public class PlayerSensor extends Sensor<LivingEntity> {
 
     @Override
     protected void doTick(final ServerLevel level, final LivingEntity body) {
+        double followDistance = this.getFollowDistance(body);
         List<Player> players = level.players()
             .stream()
             .filter(EntitySelector.NO_SPECTATORS)
-            .filter(player -> body.closerThan(player, this.getFollowDistance(body)))
-            .sorted(Comparator.comparingDouble(body::distanceToSqr))
+            .filter(player -> body.closerThan(player, followDistance))
             .collect(Collectors.toList());
+        if (!players.isEmpty() && AsyncSensorService.scheduleNearestPlayers(level, body, players, followDistance)) {
+            return;
+        }
+        players.sort(Comparator.comparingDouble(body::distanceToSqr));
         Brain<?> brain = body.getBrain();
         brain.setMemory(MemoryModuleType.NEAREST_PLAYERS, players);
         List<Player> visiblePlayers = players.stream().filter(livingEntity -> isEntityTargetable(level, body, livingEntity)).collect(Collectors.toList());
