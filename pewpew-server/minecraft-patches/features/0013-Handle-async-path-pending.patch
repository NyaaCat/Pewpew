-        Path path = villager.getNavigation().createPath(pos, poiType.value().validRange());
-        return path != null && path.canReach();
-    }
+    private boolean canReach(Villager villager, BlockPos pos, Holder<PoiType> poiType) {
+        float followRange = villager.getNavigation().getMaxPathLength();
+        int range = (int)(followRange + 8.0F);
+        PathNavigationRegion region = new PathNavigationRegion(
+            villager.level(),
+            villager.blockPosition().offset(-range, -range, -range),
+            villager.blockPosition().offset(range, range, range)
+        );
+        Path path = villager.getNavigation().pathFinder.findPath(
+            region,
+            villager,
+            java.util.Set.of(pos),
+            followRange,
+            poiType.value().validRange(),
+            villager.getNavigation().getMaxVisitedNodesMultiplier()
+        );
+        return path != null && path.canReach();
+    }
