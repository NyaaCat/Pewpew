Subject: [PATCH] Use spawn snapshots for block-state reads


diff --git a/net/minecraft/world/level/NaturalSpawner.java b/net/minecraft/world/level/NaturalSpawner.java
index 15b11bc9b4c9c7e4e674831eda43c9b20641a326..6078180a98c469941908db0d87e3b5b59a4ea92b 100644
--- a/net/minecraft/world/level/NaturalSpawner.java
+++ b/net/minecraft/world/level/NaturalSpawner.java
@@ -285,7 +285,7 @@ public final class NaturalSpawner {
         ChunkGenerator generator = level.getChunkSource().getGenerator();
         LevelReader spawnLevel = snapshot != null ? snapshot.levelReader : level;
         int y = pos.getY();
-        BlockState blockState = level.getBlockStateIfLoadedAndInBounds(pos); // Paper - don't load chunks for mob spawn
+        BlockState blockState = getBlockStateIfLoadedAndInBounds(level, pos, snapshot); // Paper - don't load chunks for mob spawn
         if (blockState != null && !blockState.isRedstoneConductor(chunk, pos)) { // Paper - don't load chunks for mob spawn
             BlockPos.MutableBlockPos mutableBlockPos = new BlockPos.MutableBlockPos();
             int i = 0;
@@ -308,7 +308,7 @@ public final class NaturalSpawner {
                     Player nearestPlayer = level.getNearestPlayer(d, y, d1, -1.0, false);
                     if (nearestPlayer != null) {
                         double d2 = nearestPlayer.distanceToSqr(d, y, d1);
-                        if (level.isLoadedAndInBounds(mutableBlockPos) && isRightDistanceToPlayerAndSpawnPoint(level, chunk, mutableBlockPos, d2)) { // Paper - don't load chunks for mob spawn
+                        if (isLoadedAndInBounds(level, mutableBlockPos, snapshot) && isRightDistanceToPlayerAndSpawnPoint(level, chunk, mutableBlockPos, d2)) { // Paper - don't load chunks for mob spawn
                             if (spawnerData == null) {
                                 Optional<MobSpawnSettings.SpawnerData> randomSpawnMobAt = getRandomSpawnMobAt(
                                     level, structureManager, generator, category, level.random, mutableBlockPos, spawnLevel
@@ -374,6 +374,27 @@ public final class NaturalSpawner {
         }
     }
 
+    @Nullable
+    private static BlockState getBlockStateIfLoadedAndInBounds(ServerLevel level, BlockPos pos, @Nullable SpawnChunkSnapshot snapshot) {
+        if (!level.getWorldBorder().isWithinBounds(pos)) {
+            return null;
+        }
+        if (snapshot != null && snapshot.contains(pos)) {
+            return snapshot.getBlockState(pos);
+        }
+        return level.getBlockStateIfLoaded(pos);
+    }
+
+    private static boolean isLoadedAndInBounds(ServerLevel level, BlockPos pos, @Nullable SpawnChunkSnapshot snapshot) {
+        if (!level.getWorldBorder().isWithinBounds(pos)) {
+            return false;
+        }
+        if (snapshot != null && snapshot.contains(pos)) {
+            return true;
+        }
+        return level.getChunkIfLoaded(pos) != null;
+    }
+
     private static boolean isRightDistanceToPlayerAndSpawnPoint(ServerLevel level, ChunkAccess chunk, BlockPos.MutableBlockPos pos, double distance) {
         if (distance <= 576.0) {
             return false;
