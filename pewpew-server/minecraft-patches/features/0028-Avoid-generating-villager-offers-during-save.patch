From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Phoenix Bot <w@c.at>
Date: Wed, 21 Jan 2026 14:46:24 +0000
Subject: [PATCH] Avoid generating villager offers during save


diff --git a/net/minecraft/world/entity/npc/villager/AbstractVillager.java b/net/minecraft/world/entity/npc/villager/AbstractVillager.java
index 9582f694ddbb47be7d820c5fe8791d5ba112ec6b..96e58c11d432d0806777fe974e44d1666caba511 100644
--- a/net/minecraft/world/entity/npc/villager/AbstractVillager.java
+++ b/net/minecraft/world/entity/npc/villager/AbstractVillager.java
@@ -199,8 +199,9 @@ public abstract class AbstractVillager extends AgeableMob implements Npc, Mercha
     protected void addAdditionalSaveData(final ValueOutput output) {
         super.addAdditionalSaveData(output);
         if (!this.level().isClientSide()) {
-            MerchantOffers offers = this.getOffers();
-            if (!offers.isEmpty()) {
+            // Avoid generating trades during save; that can trigger sync chunk loads while unloading.
+            MerchantOffers offers = this.offers;
+            if (offers != null && !offers.isEmpty()) {
                 output.store("Offers", MerchantOffers.CODEC, offers);
             }
         }
