Subject: [PATCH] Fix hopper thread-local guards and water item activation


diff --git a/io/papermc/paper/entity/activation/ActivationRange.java b/io/papermc/paper/entity/activation/ActivationRange.java
index ce6b57eeeeb1bd652f4bb53c19dcfbc05126c7e9..4d8f01fe880bdcbe8d599a65608747ba0e8dab41 100644
--- a/io/papermc/paper/entity/activation/ActivationRange.java
+++ b/io/papermc/paper/entity/activation/ActivationRange.java
@@ -288,10 +288,19 @@ public final class ActivationRange {
      * @return
      */
     public static boolean checkIfActive(final Entity entity) {
-        // Never safe to skip fireworks or item gravity
-        if (entity instanceof FireworkRocketEntity || (entity instanceof ItemEntity && (entity.tickCount + entity.getId()) % 4 == 0)) { // Needed for item gravity, see ItemEntity tick
+        if (entity instanceof FireworkRocketEntity) {
             return true;
         }
+        if (entity instanceof ItemEntity) {
+            // Keep waterstream transport deterministic outside activation range.
+            if (entity.isInWater() && entity.isPushedByFluid()) {
+                return true;
+            }
+            // Needed for item gravity, see ItemEntity#tick.
+            if ((entity.tickCount + entity.getId()) % 4 == 0) {
+                return true;
+            }
+        }
         // special case always immunities
         // immunize brand-new entities, dead entities, and portal scenarios
         if (entity.defaultActivationState || entity.tickCount < 20 * 10 || !entity.isAlive() || (entity.portalProcess != null && !entity.portalProcess.hasExpired()) || entity.portalCooldown > 0) {
