 package net.minecraft.world.level.pathfinder;
 
+import it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap;
 import java.util.List;
 import javax.annotation.Nullable;
 import net.minecraft.core.BlockPos;
@@ -57,6 +58,18 @@ public final class SnapshotPathNavigationRegion implements CollisionGetter {
     }
 
     public static SnapshotPathNavigationRegion capture(ServerLevel level, BlockPos minPos, BlockPos maxPos) {
+        return capture(level, minPos, maxPos, null);
+    }
+
+    public static SnapshotPathNavigationRegion capture(
+        ServerLevel level,
+        BlockPos minPos,
+        BlockPos maxPos,
+        @Nullable SectionCache cache
+    ) {
+        if (cache != null) {
+            cache.reset(level.getGameTime());
+        }
         int minChunkX = SectionPos.blockToSectionCoord(Math.min(minPos.getX(), maxPos.getX()));
         int maxChunkX = SectionPos.blockToSectionCoord(Math.max(minPos.getX(), maxPos.getX()));
         int minChunkZ = SectionPos.blockToSectionCoord(Math.min(minPos.getZ(), maxPos.getZ()));
@@ -90,9 +103,15 @@ public final class SnapshotPathNavigationRegion implements CollisionGetter {
                         continue;
                     }
                     LevelChunkSection section = chunk.getSection(sectionIndex);
-                    sectionVersions[sectionY - minSectionY] = section.getChangeVersion();
+                    long version = section.getChangeVersion();
+                    sectionVersions[sectionY - minSectionY] = version;
                     if (!section.hasOnlyAir()) {
-                        sectionStates[sectionY - minSectionY] = section.states.copy();
+                        if (cache == null) {
+                            sectionStates[sectionY - minSectionY] = section.states.copy();
+                        } else {
+                            long sectionKey = SectionPos.asLong(cx, sectionY, cz);
+                            sectionStates[sectionY - minSectionY] = cache.snapshot(section, version, sectionKey);
+                        }
                     }
                 }
                 chunks[cx - minChunkX][cz - minChunkZ] = SnapshotChunk.loaded(sectionStates, sectionVersions);
@@ -246,6 +265,39 @@ public final class SnapshotPathNavigationRegion implements CollisionGetter {
         return this.height;
     }
 
+    public static final class SectionCache {
+        private long tickId = Long.MIN_VALUE;
+        private final Long2ObjectOpenHashMap<SectionSnapshot> sections = new Long2ObjectOpenHashMap<>();
+
+        public void reset(long tickId) {
+            if (this.tickId == tickId) {
+                return;
+            }
+            this.tickId = tickId;
+            this.sections.clear();
+        }
+
+        private PalettedContainer<BlockState> snapshot(LevelChunkSection section, long version, long sectionKey) {
+            SectionSnapshot cached = this.sections.get(sectionKey);
+            if (cached != null && cached.version == version) {
+                return cached.states;
+            }
+            PalettedContainer<BlockState> copy = section.states.copy();
+            this.sections.put(sectionKey, new SectionSnapshot(version, copy));
+            return copy;
+        }
+
+        private static final class SectionSnapshot {
+            private final long version;
+            private final PalettedContainer<BlockState> states;
+
+            private SectionSnapshot(long version, PalettedContainer<BlockState> states) {
+                this.version = version;
+                this.states = states;
+            }
+        }
+    }
+
     private static final class SnapshotChunk {
         private static final SnapshotChunk MISSING = new SnapshotChunk(false, new PalettedContainer[0], new long[0]);
 
@@ -267,4 +319,4 @@ public final class SnapshotPathNavigationRegion implements CollisionGetter {
             return new SnapshotChunk(true, sectionStates, sectionVersions);
         }
     }
-}
