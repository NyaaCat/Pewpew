+    private static int pendingTimeoutTicks() {
+        return Math.max(MIN_PENDING_TIMEOUT_TICKS, Integer.getInteger(PENDING_TIMEOUT_TICKS_PROPERTY, DEFAULT_PENDING_TIMEOUT_TICKS));
+    }
+
+    private static boolean isExpired(final AsyncPath asyncPath, final long gameTime) {
+        return gameTime - asyncPath.createdGameTime() >= pendingTimeoutTicks();
+    }
+
+    private static boolean isExpired(final long createdGameTime, final long gameTime) {
+        return gameTime - createdGameTime >= pendingTimeoutTicks();
+    }
+
+    private boolean expirePending(final UUID mobId, final PathNavigation navigation, final AsyncPath asyncPath) {
+        final PendingRequest request = this.pending.get(mobId);
+        if (request == null || request.navigation != navigation || request.asyncPath != asyncPath) {
+            asyncPath.complete(null);
+            return true;
+        }
+        return this.expirePending(request);
+    }
+
+    private boolean expirePending(final PendingRequest request) {
+        if (!this.pending.remove(request.mobId, request)) {
+            return false;
+        }
+        request.completeFailure();
+        return true;
+    }
+
+    private boolean expirePendingPoi(final PendingPoiRequest request) {
+        if (!this.pendingPoi.remove(request.mobId, request)) {
+            return false;
+        }
+        request.callback.accept(null);
+        return true;
+    }
