From 0bc9ace716513e762634dec25c3e0fd1ce55cf21 Mon Sep 17 00:00:00 2001
From: Phoenix Bot <w@c.at>
Date: Mon, 26 Jan 2026 15:30:10 +0000
Subject: [PATCH] Defer ender pearl teleports under world tick coordinator

---
 .../entity/projectile/ThrownEnderpearl.java   | 88 ++++++++++++-------
 1 file changed, 56 insertions(+), 32 deletions(-)

diff --git a/net/minecraft/world/entity/projectile/ThrownEnderpearl.java b/net/minecraft/world/entity/projectile/ThrownEnderpearl.java
index 5aa63c9..1088350 100644
--- a/net/minecraft/world/entity/projectile/ThrownEnderpearl.java
+++ b/net/minecraft/world/entity/projectile/ThrownEnderpearl.java
@@ -116,6 +116,8 @@ public class ThrownEnderpearl extends ThrowableItemProjectile {
         if (this.level() instanceof ServerLevel serverLevel && !this.isRemoved()) {
             Entity owner = this.getOwner();
             if (owner != null && isAllowedToTeleportOwner(owner, serverLevel)) {
+                final boolean deferTeleport = io.papermc.paper.pewpew.WorldTickCoordinator.isEnabled()
+                    && !io.papermc.paper.util.MCUtil.isMainThread();
                 Vec3 vec3 = this.oldPosition();
                 if (owner instanceof ServerPlayer serverPlayer) {
                     if (serverPlayer.connection.isAcceptingMessages()) {
@@ -123,48 +125,70 @@ public class ThrownEnderpearl extends ThrowableItemProjectile {
                         // Store pre teleportation position as the teleport has been moved up.
                         final double preTeleportX = serverPlayer.getX(), preTeleportY = serverPlayer.getY(), preTeleportZ = serverPlayer.getZ();
                         final float preTeleportYRot = serverPlayer.getYRot(), preTeleportXRot = serverPlayer.getXRot();
-                        ServerPlayer serverPlayer1 = serverPlayer.teleport(new TeleportTransition(serverLevel, vec3, Vec3.ZERO, 0.0F, 0.0F, Relative.union(Relative.ROTATION, Relative.DELTA), TeleportTransition.DO_NOTHING, org.bukkit.event.player.PlayerTeleportEvent.TeleportCause.ENDER_PEARL));
-                        if (serverPlayer1 == null) {
-                            this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.HIT);
-                            return;
-                        }
-                        // CraftBukkit end
-                        if (this.random.nextFloat() < 0.05F && serverLevel.getGameRules().getBoolean(GameRules.RULE_DOMOBSPAWNING)) {
-                            Endermite endermite = EntityType.ENDERMITE.create(serverLevel, EntitySpawnReason.TRIGGERED);
-                            if (endermite != null) {
-                                endermite.snapTo(preTeleportX, preTeleportY, preTeleportZ, preTeleportYRot, preTeleportXRot); // Paper - spawn endermite at pre teleport position as teleport has been moved up
-                                serverLevel.addFreshEntity(endermite, org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.ENDER_PEARL);
+                        final boolean spawnEndermite = this.random.nextFloat() < 0.05F
+                            && serverLevel.getGameRules().getBoolean(GameRules.RULE_DOMOBSPAWNING);
+                        final boolean portalCooldown = this.isOnPortalCooldown();
+                        final Runnable teleportTask = () -> {
+                            if (!isAllowedToTeleportOwner(serverPlayer, serverLevel) || !serverPlayer.connection.isAcceptingMessages()) {
+                                return;
+                            }
+                            ServerPlayer serverPlayer1 = serverPlayer.teleport(new TeleportTransition(serverLevel, vec3, Vec3.ZERO, 0.0F, 0.0F, Relative.union(Relative.ROTATION, Relative.DELTA), TeleportTransition.DO_NOTHING, org.bukkit.event.player.PlayerTeleportEvent.TeleportCause.ENDER_PEARL));
+                            if (serverPlayer1 == null) {
+                                return;
+                            }
+                            // CraftBukkit end
+                            if (spawnEndermite) {
+                                Endermite endermite = EntityType.ENDERMITE.create(serverLevel, EntitySpawnReason.TRIGGERED);
+                                if (endermite != null) {
+                                    endermite.snapTo(preTeleportX, preTeleportY, preTeleportZ, preTeleportYRot, preTeleportXRot); // Paper - spawn endermite at pre teleport position as teleport has been moved up
+                                    serverLevel.addFreshEntity(endermite, org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.ENDER_PEARL);
+                                }
                             }
-                        }
 
-                        if (this.isOnPortalCooldown()) {
-                            owner.setPortalCooldown();
-                        }
+                            if (portalCooldown) {
+                                owner.setPortalCooldown();
+                            }
 
-                        // CraftBukkit start - moved up
-                        // ServerPlayer serverPlayer1 = serverPlayer.teleport(
-                        //     new TeleportTransition(
-                        //         serverLevel, vec3, Vec3.ZERO, 0.0F, 0.0F, Relative.union(Relative.ROTATION, Relative.DELTA), TeleportTransition.DO_NOTHING
-                        //     )
-                        // );
-                        // CraftBukkit end - moved up
-                        if (serverPlayer1 != null) {
+                            // CraftBukkit start - moved up
+                            // ServerPlayer serverPlayer1 = serverPlayer.teleport(
+                            //     new TeleportTransition(
+                            //         serverLevel, vec3, Vec3.ZERO, 0.0F, 0.0F, Relative.union(Relative.ROTATION, Relative.DELTA), TeleportTransition.DO_NOTHING
+                            //     )
+                            // );
+                            // CraftBukkit end - moved up
                             serverPlayer1.resetFallDistance();
                             serverPlayer1.resetCurrentImpulseContext();
                             serverPlayer1.hurtServer(serverPlayer.level(), this.damageSources().enderPearl().eventEntityDamager(this), 5.0F); // CraftBukkit // Paper - fix DamageSource API
-                        }
 
-                        this.playSound(serverLevel, vec3);
+                            this.playSound(serverLevel, vec3);
+                        };
+                        if (deferTeleport) {
+                            io.papermc.paper.pewpew.WorldTickCoordinator.get().enqueueGlobalCommit(teleportTask);
+                            this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.HIT);
+                            return;
+                        }
+                        teleportTask.run();
                     }
                 } else {
-                    Entity entity = owner.teleport(
-                        new TeleportTransition(serverLevel, vec3, owner.getDeltaMovement(), owner.getYRot(), owner.getXRot(), TeleportTransition.DO_NOTHING)
-                    );
-                    if (entity != null) {
-                        entity.resetFallDistance();
-                    }
+                    final Runnable teleportTask = () -> {
+                        if (!isAllowedToTeleportOwner(owner, serverLevel)) {
+                            return;
+                        }
+                        Entity entity = owner.teleport(
+                            new TeleportTransition(serverLevel, vec3, owner.getDeltaMovement(), owner.getYRot(), owner.getXRot(), TeleportTransition.DO_NOTHING)
+                        );
+                        if (entity != null) {
+                            entity.resetFallDistance();
+                        }
 
-                    this.playSound(serverLevel, vec3);
+                        this.playSound(serverLevel, vec3);
+                    };
+                    if (deferTeleport) {
+                        io.papermc.paper.pewpew.WorldTickCoordinator.get().enqueueGlobalCommit(teleportTask);
+                        this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.HIT);
+                        return;
+                    }
+                    teleportTask.run();
                 }
 
                 this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.HIT); // CraftBukkit - add Bukkit remove cause
