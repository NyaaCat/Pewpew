+    private static double getNearestPlayerDistanceSqr(
+        ServerLevel level,
+        @Nullable ServerPlayer[] spawnPlayersRaw,
+        int spawnPlayersCount,
+        double x,
+        double y,
+        double z
+    ) {
+        if (spawnPlayersRaw == null) {
+            Player nearestPlayer = level.getNearestPlayer(x, y, z, -1.0, false);
+            return nearestPlayer == null ? -1.0 : nearestPlayer.distanceToSqr(x, y, z);
+        }
+        double nearest = -1.0;
+        for (int i = 0; i < spawnPlayersCount; i++) {
+            ServerPlayer player = spawnPlayersRaw[i];
+            if (player.isSpectator()) {
+                continue;
+            }
+            double distance = player.distanceToSqr(x, y, z);
+            if (nearest < 0.0 || distance < nearest) {
+                nearest = distance;
+            }
+        }
+        return nearest;
+    }
+
