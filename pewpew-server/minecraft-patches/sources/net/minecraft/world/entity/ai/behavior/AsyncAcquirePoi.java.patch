+package net.minecraft.world.entity.ai.behavior;
+
+import com.mojang.datafixers.util.Pair;
+import io.papermc.paper.pewpew.PewpewAsyncPool;
+import io.papermc.paper.pewpew.WorldTickCoordinator;
+import it.unimi.dsi.fastutil.longs.Long2ObjectMap;
+import java.util.Optional;
+import java.util.Set;
+import java.util.UUID;
+import java.util.concurrent.RejectedExecutionException;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.logging.Level;
+import java.util.logging.Logger;
+import java.util.function.Predicate;
+import javax.annotation.Nullable;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.GlobalPos;
+import net.minecraft.core.Holder;
+import net.minecraft.network.protocol.game.DebugPackets;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.PathfinderMob;
+import net.minecraft.world.entity.ai.memory.MemoryModuleType;
+import net.minecraft.world.entity.ai.village.poi.PoiManager;
+import net.minecraft.world.entity.ai.village.poi.PoiType;
+import net.minecraft.world.entity.ai.navigation.GroundPathNavigation;
+import net.minecraft.world.entity.ai.navigation.PathNavigation;
+import net.minecraft.world.level.pathfinder.MobPathSnapshot;
+import net.minecraft.world.level.pathfinder.Path;
+import net.minecraft.world.level.pathfinder.SnapshotPathFinder;
+import net.minecraft.world.level.pathfinder.SnapshotPathNavigationRegion;
+import net.minecraft.world.level.pathfinder.SnapshotWalkNodeEvaluator;
+
+public final class AsyncAcquirePoi {
+    private static final Logger LOGGER = Logger.getLogger(AsyncAcquirePoi.class.getName());
+    private static final String ENABLE_PROPERTY = "pewpew.asyncPathfinding";
+    private static final AsyncAcquirePoi INSTANCE = new AsyncAcquirePoi();
+
+    private final java.util.concurrent.ConcurrentHashMap<UUID, PendingRequest> pending = new java.util.concurrent.ConcurrentHashMap<>();
+    private final AtomicBoolean initialized = new AtomicBoolean();
+    private volatile ThreadPoolExecutor executor;
+
+    private AsyncAcquirePoi() {
+    }
+
+    public static boolean isEnabled() {
+        return Boolean.getBoolean(ENABLE_PROPERTY);
+    }
+
+    public static void invalidateWorld(final String worldName) {
+        INSTANCE.pending.entrySet().removeIf(entry -> entry.getValue().worldName.equals(worldName));
+    }
+
+    public static boolean schedule(
+        final ServerLevel level,
+        final PathfinderMob mob,
+        final Set<Pair<Holder<PoiType>, BlockPos>> poiPositions,
+        final int accuracy,
+        final Predicate<Holder<PoiType>> acquirablePois,
+        final MemoryModuleType<GlobalPos> acquiringMemory,
+        final Optional<Byte> entityEventId,
+        final Long2ObjectMap<AcquirePoi.JitteredLinearRetry> retryMap,
+        final long time
+    ) {
+        return INSTANCE.scheduleInternal(
+            level,
+            mob,
+            poiPositions,
+            accuracy,
+            acquirablePois,
+            acquiringMemory,
+            entityEventId,
+            retryMap,
+            time
+        );
+    }
+
+    private boolean scheduleInternal(
+        final ServerLevel level,
+        final PathfinderMob mob,
+        final Set<Pair<Holder<PoiType>, BlockPos>> poiPositions,
+        final int accuracy,
+        final Predicate<Holder<PoiType>> acquirablePois,
+        final MemoryModuleType<GlobalPos> acquiringMemory,
+        final Optional<Byte> entityEventId,
+        final Long2ObjectMap<AcquirePoi.JitteredLinearRetry> retryMap,
+        final long time
+    ) {
+        if (!isEnabled()) {
+            return false;
+        }
+        if (poiPositions.isEmpty()) {
+            return false;
+        }
+        PathNavigation navigation = mob.getNavigation();
+        if (!(navigation instanceof GroundPathNavigation)) {
+            return false;
+        }
+        init();
+        final UUID mobId = mob.getUUID();
+        final PendingRequest request = new PendingRequest(
+            level,
+            mobId,
+            mob.blockPosition(),
+            MobPathSnapshot.from(mob),
+            SnapshotPathNavigationRegion.capture(level, captureMin(mob), captureMax(mob)),
+            poiPositions.stream().map(Pair::getSecond).collect(java.util.stream.Collectors.toSet()),
+            navigation.getMaxPathLength(),
+            accuracy,
+            navigation.getMaxVisitedNodesMultiplier(),
+            navigation.getNodeEvaluator().canPassDoors(),
+            navigation.getNodeEvaluator().canOpenDoors(),
+            navigation.getNodeEvaluator().canFloat(),
+            navigation.getNodeEvaluator().canWalkOverFences(),
+            acquirablePois,
+            acquiringMemory,
+            entityEventId,
+            retryMap,
+            time,
+            WorldTickCoordinator.get().currentGeneration(level.getWorld().getName())
+        );
+        if (this.pending.putIfAbsent(mobId, request) != null) {
+            return true;
+        }
+        try {
+            this.executor.execute(request::runAsync);
+        } catch (RejectedExecutionException ex) {
+            this.pending.remove(mobId, request);
+            return false;
+        }
+        return true;
+    }
+
+    private void init() {
+        if (!this.initialized.compareAndSet(false, true)) {
+            return;
+        }
+        this.executor = (ThreadPoolExecutor)PewpewAsyncPool.get();
+    }
+
+    private static BlockPos captureMin(final PathfinderMob mob) {
+        final int range = (int)(mob.getNavigation().getMaxPathLength() + 8);
+        final BlockPos center = mob.blockPosition();
+        return center.offset(-range, -range, -range);
+    }
+
+    private static BlockPos captureMax(final PathfinderMob mob) {
+        final int range = (int)(mob.getNavigation().getMaxPathLength() + 8);
+        final BlockPos center = mob.blockPosition();
+        return center.offset(range, range, range);
+    }
+
+    private final class PendingRequest {
+        private final ServerLevel level;
+        private final String worldName;
+        private final UUID mobId;
+        private final BlockPos originPos;
+        private final MobPathSnapshot mobSnapshot;
+        private final SnapshotPathNavigationRegion region;
+        private final Set<BlockPos> targets;
+        private final float maxRange;
+        private final int accuracy;
+        private final float searchDepthMultiplier;
+        private final boolean canPassDoors;
+        private final boolean canOpenDoors;
+        private final boolean canFloat;
+        private final boolean canWalkOverFences;
+        private final Predicate<Holder<PoiType>> acquirablePois;
+        private final MemoryModuleType<GlobalPos> acquiringMemory;
+        private final Optional<Byte> entityEventId;
+        private final Long2ObjectMap<AcquirePoi.JitteredLinearRetry> retryMap;
+        private final long time;
+        private final long generationId;
+
+        private PendingRequest(
+            final ServerLevel level,
+            final UUID mobId,
+            final BlockPos originPos,
+            final MobPathSnapshot mobSnapshot,
+            final SnapshotPathNavigationRegion region,
+            final Set<BlockPos> targets,
+            final float maxRange,
+            final int accuracy,
+            final float searchDepthMultiplier,
+            final boolean canPassDoors,
+            final boolean canOpenDoors,
+            final boolean canFloat,
+            final boolean canWalkOverFences,
+            final Predicate<Holder<PoiType>> acquirablePois,
+            final MemoryModuleType<GlobalPos> acquiringMemory,
+            final Optional<Byte> entityEventId,
+            final Long2ObjectMap<AcquirePoi.JitteredLinearRetry> retryMap,
+            final long time,
+            final long generationId
+        ) {
+            this.level = level;
+            this.worldName = level.getWorld().getName();
+            this.mobId = mobId;
+            this.originPos = originPos;
+            this.mobSnapshot = mobSnapshot;
+            this.region = region;
+            this.targets = targets;
+            this.maxRange = maxRange;
+            this.accuracy = accuracy;
+            this.searchDepthMultiplier = searchDepthMultiplier;
+            this.canPassDoors = canPassDoors;
+            this.canOpenDoors = canOpenDoors;
+            this.canFloat = canFloat;
+            this.canWalkOverFences = canWalkOverFences;
+            this.acquirablePois = acquirablePois;
+            this.acquiringMemory = acquiringMemory;
+            this.entityEventId = entityEventId;
+            this.retryMap = retryMap;
+            this.time = time;
+            this.generationId = generationId;
+        }
+
+        private void runAsync() {
+            Path path = null;
+            Throwable error = null;
+            try {
+                SnapshotWalkNodeEvaluator evaluator = new SnapshotWalkNodeEvaluator();
+                evaluator.setCanPassDoors(this.canPassDoors);
+                evaluator.setCanOpenDoors(this.canOpenDoors);
+                evaluator.setCanFloat(this.canFloat);
+                evaluator.setCanWalkOverFences(this.canWalkOverFences);
+                SnapshotPathFinder pathFinder = new SnapshotPathFinder(evaluator, Math.max(1, (int)(this.maxRange * 16.0F)));
+                path = pathFinder.findPath(this.region, this.mobSnapshot, this.targets, this.maxRange, this.accuracy, this.searchDepthMultiplier);
+            } catch (Throwable throwable) {
+                error = throwable;
+            }
+            final Path finalPath = path;
+            final Throwable finalError = error;
+            WorldTickCoordinator.get().enqueueCommit(this.worldName, this.generationId, () -> applyResult(finalPath, finalError));
+        }
+
+        private void applyResult(@Nullable Path path, @Nullable Throwable error) {
+            AsyncAcquirePoi.this.pending.remove(this.mobId, this);
+            if (error != null) {
+                LOGGER.log(Level.WARNING, "Async pathfinding failed", error);
+                return;
+            }
+            if (!this.region.isStillValid(this.level)) {
+                recordFailure();
+                return;
+            }
+            final net.minecraft.world.entity.Entity entity = this.level.getEntity(this.mobId);
+            if (!(entity instanceof PathfinderMob mob) || !mob.isAlive()) {
+                return;
+            }
+            if (!mob.blockPosition().closerThan(this.originPos, 4.0)) {
+                recordFailure();
+                return;
+            }
+            if (mob.getBrain().hasMemoryValue(this.acquiringMemory)) {
+                return;
+            }
+            if (path == null || !path.canReach()) {
+                recordFailure();
+                return;
+            }
+            final BlockPos target = path.getTarget();
+            if (target == null) {
+                recordFailure();
+                return;
+            }
+            final PoiManager poiManager = this.level.getPoiManager();
+            final Optional<Holder<PoiType>> poiType = poiManager.getType(target);
+            if (poiType.isEmpty() || !this.acquirablePois.test(poiType.get())) {
+                recordFailure();
+                return;
+            }
+            poiManager.take(this.acquirablePois, (holder, pos) -> pos.equals(target), target, 1);
+            mob.getBrain().setMemory(this.acquiringMemory, GlobalPos.of(this.level.dimension(), target));
+            this.entityEventId.ifPresent(id -> this.level.broadcastEntityEvent(mob, id));
+            this.retryMap.clear();
+            DebugPackets.sendPoiTicketCountPacket(this.level, target);
+        }
+
+        private void recordFailure() {
+            for (BlockPos target : this.targets) {
+                this.retryMap.computeIfAbsent(target.asLong(), key -> new AcquirePoi.JitteredLinearRetry(this.level.random, this.time));
+            }
+        }
+    }
+}
